      1:
        id: 'PM4-F2'
        finding_label: 'Mitochondrial ROS can carry adaptive signals'
        presentation: 'mechanistic-basis'
        fm_rollup: false
        finding_statement: 'Complex-III-dependent oxidant signals contribute to hypoxic HIF stabilisation in tested cell systems. Mitochondrial ROS therefore have physiological signalling roles as well as injury-associated roles.'
        finding_summary: 'Complex-III-dependent oxidant signals contribute to hypoxic HIF stabilisation in tested cell systems. Mitochondrial ROS therefore have physiological signalling roles as well as injury-associated roles.'
        finding_interpretation: 'Hypoxia differs from anoxia; pharmacological respiratory inhibition can perturb multiple sites. This is not evidence for indiscriminate ROS reduction or a dietary-to-brain benefit.'
        synthesised_evidence_confidence: 'not-yet-scored'
        synthesis: 'Complex-III-dependent oxidant signals contribute to hypoxic HIF stabilisation in tested cell systems. Mitochondrial ROS therefore have physiological signalling roles as well as injury-associated roles.'
        synthesis_limitations: 'Hypoxia differs from anoxia; pharmacological respiratory inhibition can perturb multiple sites. This is not evidence for indiscriminate ROS reduction or a dietary-to-brain benefit.'
        evidence_considered:
          0:
            label: 'Guzy et al. (2005)'
            citation_key: 'brs4_guzy2005_20261023'
            href: '/docs/papers/BRAIN-Diet-References#brs4_guzy2005_20261023'
            data_level: 'Mechanistic'
            evidence_source: 'bounded-external-search'
            exposure_context: 'Primary genetic and pharmacological complex-III perturbations with redox-sensitive sensors and HIF assays under low oxygen.'
            directional_finding: 'Complex-III function and oxidant signalling were required for the tested hypoxic HIF response.'
            assessment:
              study: 'Primary genetic and pharmacological complex-III perturbations with redox-sensitive sensors and HIF assays under low oxygen.'
              population: 'Cultured mammalian cells exposed to hypoxia.'
              result: 'Complex-III function and oxidant signalling were required for the tested hypoxic HIF response.'
              effect_magnitude: 'Study-specific direction retained; no pooled estimate or ordinary-food effective dose inferred.'
              evidence_summary: 'Complex-III function and oxidant signalling were required for the tested hypoxic HIF response.'
              limitations: 'Context-dependent cell signalling; not all oxygen-sensing pathways or physiological states require this mechanism.'
              retrieval_scope: 'Primary abstract retrieved from Europe PMC/PubMed; no unavailable full-method quantities inferred.'
              source_url: 'https://pubmed.ncbi.nlm.nih.gov/16054089/'
              publication_classification: 'primary-experimental'
        evidence_dependency:
          0: 'Sources support the specified links only. Reuse in another Finding or PM is not independent replication; composition, local mechanism, exposure and clinical outcomes are distinct.'
      2:
        id: 'PM4-F3'
        finding_label: 'High-fat exposure altered mitochondrial H2O2-emitting potential'
        presentation: 'mechanistic-basis'
        fm_rollup: false
        finding_statement: 'A specified high-fat meal and short high-fat feeding period increased skeletal-muscle mitochondrial H2O2-emitting potential in a small human experiment; separate rodent perturbations supported a role for mitochondrial oxidants in insulin resistance.'
        finding_summary: 'A specified high-fat meal and short high-fat feeding period increased skeletal-muscle mitochondrial H2O2-emitting potential in a small human experiment; separate rodent perturbations supported a role for mitochondrial oxidants in insulin resistance.'
        finding_interpretation: 'Net H2O2 emission reflects production and scavenging under assay conditions. Human meal findings do not establish a specific ROS-generating site, benefit from a proposed replacement meal, effects of all dietary fats, brain outcomes or human causal mediation.'
        synthesised_evidence_confidence: 'not-yet-scored'
        synthesis: 'A specified high-fat meal and short high-fat feeding period increased skeletal-muscle mitochondrial H2O2-emitting potential in a small human experiment; separate rodent perturbations supported a role for mitochondrial oxidants in insulin resistance.'
        synthesis_limitations: 'Net H2O2 emission reflects production and scavenging under assay conditions. Human meal findings do not establish a specific ROS-generating site, benefit from a proposed replacement meal, effects of all dietary fats, brain outcomes or human causal mediation.'
        evidence_considered:
          0:
            label: 'Anderson et al. (2009)'
            citation_key: 'brs4_anderson2009_20261023'
            href: '/docs/papers/BRAIN-Diet-References#brs4_anderson2009_20261023'
            data_level: 'Human Study'
            evidence_source: 'bounded-external-search'
            exposure_context: 'Primary human muscle-biopsy meal/feeding experiment plus separate rodent high-fat feeding, mitochondrial-antioxidant and mitochondrial-catalase experiments.'
            directional_finding: 'After a meal providing >60% energy from fat and five days of high-fat feeding, muscle mitochondrial H2O2-emitting potential increased; rodent antioxidant manipulations preserved insulin sensitivity.'
            assessment:
              study: 'Primary human muscle-biopsy meal/feeding experiment plus separate rodent high-fat feeding, mitochondrial-antioxidant and mitochondrial-catalase experiments.'
              population: 'Nine healthy lean men in the acute/short-feeding experiment; separate lean/obese comparisons and rodent models.'
              result: 'After a meal providing >60% energy from fat and five days of high-fat feeding, muscle mitochondrial H2O2-emitting potential increased; rodent antioxidant manipulations preserved insulin sensitivity.'
              effect_magnitude: 'Study-specific direction retained; no pooled estimate or ordinary-food effective dose inferred.'
              evidence_summary: 'After a meal providing >60% energy from fat and five days of high-fat feeding, muscle mitochondrial H2O2-emitting potential increased; rodent antioxidant manipulations preserved insulin sensitivity.'
              limitations: 'The meal provided 35% of daily energy; post-meal biopsy was at four hours. Small non-randomised feeding sequence and assay-specific emission; rodent causality must not be assigned to the human cohort.'
              retrieval_scope: 'Primary full-text methods and abstract examined (PMC2648700), including distinct human and rodent arms.'
              source_url: 'https://pubmed.ncbi.nlm.nih.gov/19188683/'
              publication_classification: 'primary-experimental'
        evidence_dependency:
          0: 'Sources support the specified links only. Reuse in another Finding or PM is not independent replication; composition, local mechanism, exposure and clinical outcomes are distinct.'
      3:
        id: 'PM4-F4'
        finding_label: 'Inactivity and training changed mitochondrial H2O2 emission'
        presentation: 'mechanistic-basis'
        fm_rollup: false
        finding_statement: 'Two weeks of leg immobilisation increased muscle mitochondrial H2O2 emission at a controlled membrane potential; six weeks of aerobic retraining restored emission and ATP-generating respiration toward baseline. Acute exercise responses were respiratory-state dependent in a separate study.'
        finding_summary: 'Two weeks of leg immobilisation increased muscle mitochondrial H2O2 emission at a controlled membrane potential; six weeks of aerobic retraining restored emission and ATP-generating respiration toward baseline. Acute exercise responses were respiratory-state dependent in a separate study.'
        finding_interpretation: 'Measured emission is not pure source production. Immobilisation/retraining does not establish a universal exercise dose or a brain/ADHD effect. Acute and chronic exercise effects must not be collapsed into “exercise lowers ROS”.'
        synthesised_evidence_confidence: 'not-yet-scored'
        synthesis: 'Two weeks of leg immobilisation increased muscle mitochondrial H2O2 emission at a controlled membrane potential; six weeks of aerobic retraining restored emission and ATP-generating respiration toward baseline. Acute exercise responses were respiratory-state dependent in a separate study.'
        synthesis_limitations: 'Measured emission is not pure source production. Immobilisation/retraining does not establish a universal exercise dose or a brain/ADHD effect. Acute and chronic exercise effects must not be collapsed into “exercise lowers ROS”.'
        evidence_considered:
          0:
