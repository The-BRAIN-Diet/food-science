        record:
          id: 'glycaemic-f6-assessment-v1'
          findingId: 'PM2-F6'
          title: 'Early eating and glucose variability'
          pmId: 'BRS6-FM1-PM2'
          proposition: 'In a small prediabetes crossover, the tested early, front-loaded eating schedule reduced mean amplitude of glycaemic excursions (MAGE) over six days versus later calorie distribution; mean glucose and several other variability/range measures were inconclusive.'
          recordVersion: 1
          lastEvidenceAssessmentDate: '2026-10-18'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          factors:
            D: 2
            B: 1
            P: 1
            R: 1
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rationale:
            D: 'Assesses the measured MAGE contrast, not an isolated circadian mechanism.'
            B: 'Matched feeding and randomised order help; no washout and a small crossover leave residual concerns.'
            P: 'MAGE was informative, with mixed endpoints and limited transportability.'
            R: 'Independent Jamshed trial offers partial corroboration only: different window/population and just six usable CGM records. Same-cohort publications are not extra replications.'
          rawScore: 5
          adjustedScore: 5
          capRationale: 'No existing confidence ceiling is triggered. Replication 0, where assessed, is not an extra subtraction. No confidence is transferred to a different protocol.'
          scopeNote: 'Preview-only proposed Finding. No inference to ADHD, cognition, human dietary benefit beyond the tested endpoint, or long-term clinical outcomes.'
          limitations:
            0: 'Small sample, no washout; timing, eating-window length and calorie distribution cannot be separated.'
            1: 'No human scientific review recorded. Provisional SEC is distinct from intervention admission and PM evidence-review status.'
          sources:
            supporting:
              0: 'stage2-ref-bruno'
              1: 'stage2-ref-jamshed'
            contradictory:
            contextual:
            contradictoryAssessment: 'MAGE 2.4 versus 2.9 mmol/L (p=0.001); mean glucose, SD and time 70-180 mg/dL were not significantly different.'
            targetedChecks:
              0:
                doi: '10.1016/j.isci.2024.111501'
                role: 'Supporting, mixed endpoints'
                access: 'Full primary Methods/Results'
                assessment: '10 adults with prediabetes and overweight/obesity. Six days of matched weight-maintenance food: 08:00-16:00, 80% of calories before 14:00, versus usual later distribution; randomised crossover without washout. Small sample, no washout; timing, eating-window length and calorie distribution cannot be separated.'
              1:
                doi: '10.3390/nu11061234'
                role: 'Independent partial corroboration'
                access: 'Full primary Methods/Results'
                assessment: '11 completers; only six valid CGM datasets. Four-day controlled crossover: 08:00-14:00 versus 08:00-20:00; multiweek washout. Different population/window; technical CGM loss. Ravussin 2019 reports the same cohort, not another replication.'
            retrievalLimited:
          process: 'Codex bounded Stage 2A/2B reassessment, 2026-10-18, version 1; primary methods/results appraisal and protocol-specific admission review'
          methodology:
            name: 'Existing SEC calibration rubric proposal'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
          stoppingRationale: 'Stop after the load-bearing reports, material null comparisons and accessible independent comparisons were appraised. Remaining access gaps are explicit and do not justify negative evidence or invented factor values. Reopen only for evidence capable of changing an admission or factor judgement.'
