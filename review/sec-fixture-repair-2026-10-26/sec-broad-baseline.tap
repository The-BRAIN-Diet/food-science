      61:
        sha256: 'e8d8d247a0f4f145f8c0c10795294cc8105607bf1c3fe58f4cb83ccf5d2e1ce1'
        record:
          id: 'lat1-pm2-f1-assessment'
          recordVersion: 1
          pmId: 'BRS1-FM1-PM2'
          findingId: 'PM2-F1'
          title: 'Shared LAT1 transport and precursor competition'
          proposition: 'Large neutral amino acids share competitive transport through LAT1 (SLC7A5) with the SLC3A2 heavy chain; plasma composition helps shape substrate availability but is not a direct measurement of net brain uptake.'
          assessmentStatus: 'not-scored'
          assessmentComplete: false
          lastEvidenceAssessmentDate: '2026-10-19'
          process: 'Codex bounded Stage 2A/2B appraisal; full-text recovery and proposition-level SEC assessment. No human scientific review recorded.'
          methodology:
            name: 'SEC calibration rubric, existing D/B/P/R anchors and caps'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
          factors:
          factorStates:
            D: 'unresolved'
            B: 'unresolved'
            P: 'unresolved'
            R: 'unresolved'
          capRationale: 'No numerical synthesis score assigned.'
          rationale:
            D: 'Not scored: retained biochemical provenance or an interpretive/phenome boundary, not a newly quantified intervention proposition.'
            B: 'No numerical bias judgement assigned to an unscored contextual or provenance record.'
            P: 'No numerical precision judgement or zero inferred from missing assessment.'
            R: 'No numerical replication judgement assigned; curated agreement is not empirical replication.'
          limitations:
            0: 'Curated transporter and structural records do not quantify an ordinary meal effect in the human brain. The plasma-ratio proxy is not the sole determinant of net flux. The original Finding ID and source history are retained.'
            1: 'Evidence-confidence conclusions distinguish scientific limitations from retrieval limitations. No human expert review or PM-wide Reviewed status is inferred.'
          sources:
            supporting:
              0: 'https://www.uniprot.org/entry/P08195'
              1: 'https://www.ebi.ac.uk/emdb/EMD-9721'
            contextual:
              0: 'https://doi.org/10.1093/ajcn/81.5.1026'
              1: 'https://doi.org/10.3390/nu17071196'
            contradictoryAssessment: 'Ashley 1982 unfortified evening meals and the 2013 starch control did not reproduce a universal carbohydrate-induced rise. The 2025 sleep/performance null constrains functional extrapolation, not the measured acute plasma effect.'
            targetedChecks:
              0:
                doi: '10.1093/ajcn/77.1.128'
                role: 'supporting and directional correction'
                access: 'Scite abstract only; published five-page full text recovered and examined via public PDF.'
                assessment: 'Random-order crossover, Table 2, multiplicity-aware analysis; both protein-arm ratios decreased.'
              1:
                doi: '10.1016/j.clnu.2012.11.027'
                role: 'supporting with null control'
                access: 'Full institutional manuscript, UC eScholarship.'
                assessment: 'Distinct protein-source effects and starch null; six men, four visits, no human brain outcome.'
              2:
                doi: '10.1093/ajcn/36.1.143'
                role: 'contradictory to universal-direction claim'
                access: 'Scite/PubMed abstract plus author-posted results and figures.'
                assessment: 'Unfortified evening-meal ratios unchanged; different protocol, not equivalence.'
            retrievalLimited:
              0:
                url: 'https://doi.org/10.1007/BF01252031'
                limitation: 'Scite returned abstract only. Publisher/repository recovery search did not establish full methods access; no concealment, blinding or paired confidence interval assumed.'
          history:
            0:
              date: '2026-10-19'
              decision: 'Bounded reassessment in the existing isolated checkout. Preserve inherited Finding IDs, six atoms and KC decisions. Correct Wurtman direction from recovered Table 2; separate elementary provenance, plasma modulation and functional inference. PM2-only SEC integration authorised by user.'
      62:
        sha256: '715b33c114c0534231e0fb18c4739fbdb459dc7cdbb1f310c641fe0016f48ee3'
        record:
          id: 'lat1-pm2-f2-assessment'
          recordVersion: 1
          pmId: 'BRS1-FM1-PM2'
          findingId: 'PM2-F2'
          title: 'Meal composition and protein source alter plasma precursor ratios'
          proposition: 'In the studied healthy adults, meal composition and tested protein sources can alter plasma tryptophan relative to competing large neutral amino acids; the direction and tyrosine response depend on the exposure and sampling context, without establishing increased human brain transport or neurotransmitter synthesis.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          lastEvidenceAssessmentDate: '2026-10-19'
          process: 'Codex bounded Stage 2A/2B appraisal; full-text recovery and proposition-level SEC assessment. No human scientific review recorded.'
          methodology:
            name: 'SEC calibration rubric, existing D/B/P/R anchors and caps'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
          factors:
            D: 2
            B: 1
            P: 1
            R: 1
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rawScore: 5
          adjustedScore: 5
          capRationale: 'D2: no inferential cap for the plasma proposition. No B0/P0 cap applies. R1 limits replication credit; no extra deduction.'
          rationale:
            D: '2/2: controlled feeding studies measure the scoped plasma ratio directly. Human brain uptake and benefit are explicitly excluded.'
            B: '1/2: Wurtman randomised meal order, used objective assays and order-adjusted/multiplicity-aware analysis. Visible meals, one incomplete participant and incompletely established protections in historical and protein-source studies leave residual concerns; no critical bias is demonstrated.'
            P: '1/2: source-specific contrasts and reported SEM/ranges distinguish a meal effect in tested conditions. Small samples, heterogeneous protocols and limited paired uncertainty leave materially different magnitudes and boundaries plausible. Null experiments are not equivalence results.'
            R: '1/2: separate investigator groups and datasets corroborate plasma meal responsiveness, but protocol/denominator differences and credible evening/starch nulls preclude full replication credit. This is not independent replication of one exact meal protocol.'
          limitations:
            0: 'Small acute healthy-adult samples; different meals, ratio denominators and sampling windows; incomplete historical methods retrieval. No population-wide optimum or direct human brain-flux estimate. Evening null results limit generalisation but are not equivalence evidence.'
            1: 'Evidence-confidence conclusions distinguish scientific limitations from retrieval limitations. No human expert review or PM-wide Reviewed status is inferred.'
          sources:
            supporting:
              0: 'https://doi.org/10.1093/ajcn/77.1.128'
              1: 'https://doi.org/10.1007/BF01252031'
              2: 'https://doi.org/10.1016/j.clnu.2012.11.027'
            contextual:
              0: 'https://doi.org/10.1093/ajcn/81.5.1026'
              1: 'https://doi.org/10.3390/nu17071196'
            contradictoryAssessment: 'Ashley 1982 unfortified evening meals and the 2013 starch control did not reproduce a universal carbohydrate-induced rise. The 2025 sleep/performance null constrains functional extrapolation, not the measured acute plasma effect.'
            targetedChecks:
              0:
                doi: '10.1093/ajcn/77.1.128'
                role: 'supporting and directional correction'
                access: 'Scite abstract only; published five-page full text recovered and examined via public PDF.'
                assessment: 'Random-order crossover, Table 2, multiplicity-aware analysis; both protein-arm ratios decreased.'
              1:
                doi: '10.1016/j.clnu.2012.11.027'
