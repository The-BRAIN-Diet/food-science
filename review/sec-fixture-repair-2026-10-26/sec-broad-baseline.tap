          title: 'Sulforaphane protected mitochondria in defined cell experiments'
          proposition: 'Sulforaphane pretreatment protected mitochondrial lipids, proteins and enzyme activities in oxidant-challenged SH-SY5Y cells through an Nrf2-dependent mechanism; separate vascular-cell experiments measured induction of mitochondrial defences.'
          assessmentStatus: 'not-scored'
          assessmentComplete: false
          lastEvidenceAssessmentDate: '2026-10-24'
          recordedOn: '2026-10-24'
