          0: 'Sources support the specified links only. Reuse in another Finding or PM is not independent replication; composition, local mechanism, exposure and clinical outcomes are distinct.'
        connected_supportive_evidence:
          0:
            label: 'Verlaet et al. (2019)'
            why_relevant: 'Primary ADHD case-control study of erythrocyte GSH and peripheral biomarkers; historical brain-health context.'
            why_excluded: 'No mitochondrial ROS-source or mitochondrial membrane/protein protection assay; no GSH-dependent mitochondrial lactate experiment.'
          1:
            label: 'Packer et al. (1997) and Kyriazis et al. (2022)'
            why_relevant: 'Secondary antioxidant-network and diet/mitochondrial synthesis retained from the legacy corpus.'
            why_excluded: 'Not additional primary experiments or direct proof of the legacy food-pattern claims.'
          2:
            label: 'Öğütlü et al. (2023; legacy label 2022)'
            why_relevant: 'Secondary ADHD mitochondrial review retained from legacy Phenome references.'
            why_excluded: 'Not a primary Human Study or direct source-regulation trial; original citation labels and rating history retained for review.'
          3:
