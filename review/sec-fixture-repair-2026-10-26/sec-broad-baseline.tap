      15: '[UniProt — P00441, enzyme annotation version 279](/docs/papers/BRAIN-Diet-References#brs4_uniprot_p00441_20261023)'
    hide_title: true
    evidence_status: 'stage-2b-dietary-addressability'
    dietary_addressability: 'not-established'
    claim_ceiling: 'biological-dependency'
    mechanistic_authoring_required: false
    scientific_findings:
      0:
        id: 'PM4-F1'
        finding_label: 'Mitochondrial oxidant production is source- and state-dependent'
        presentation: 'mechanistic-basis'
        fm_rollup: false
        finding_statement: 'Specific mitochondrial electron-transfer sites generate superoxide and hydrogen peroxide; source-specific suppression can reduce oxidant production without inhibiting oxidative phosphorylation. Succinate oxidation during reperfusion can drive excessive production through reverse electron transport.'
        finding_summary: 'Specific mitochondrial electron-transfer sites generate superoxide and hydrogen peroxide; source-specific suppression can reduce oxidant production without inhibiting oxidative phosphorylation. Succinate oxidation during reperfusion can drive excessive production through reverse electron transport.'
        finding_interpretation: 'Experimental suppressors and ischaemia models establish source regulation, not dietary effectiveness. These results do not imply that all mitochondrial ROS are harmful or that mitochondrial emission assays isolate gross production.'
        synthesised_evidence_confidence: 'not-yet-scored'
        synthesis: 'Specific mitochondrial electron-transfer sites generate superoxide and hydrogen peroxide; source-specific suppression can reduce oxidant production without inhibiting oxidative phosphorylation. Succinate oxidation during reperfusion can drive excessive production through reverse electron transport.'
        synthesis_limitations: 'Experimental suppressors and ischaemia models establish source regulation, not dietary effectiveness. These results do not imply that all mitochondrial ROS are harmful or that mitochondrial emission assays isolate gross production.'
        evidence_considered:
          0:
            label: 'Brand et al. (2016)'
            citation_key: 'brs4_brand2016_20261023'
            href: '/docs/papers/BRAIN-Diet-References#brs4_brand2016_20261023'
            data_level: 'Mechanistic'
            evidence_source: 'bounded-external-search'
            exposure_context: 'Primary high-throughput chemical screening followed by mitochondrial/cellular assays, Drosophila experiments and perfused mouse-heart experiments.'
            directional_finding: 'S1QEL compounds suppressed site-IQ superoxide/H2O2 without inhibiting oxidative phosphorylation; protection was context-specific.'
            assessment:
              study: 'Primary high-throughput chemical screening followed by mitochondrial/cellular assays, Drosophila experiments and perfused mouse-heart experiments.'
              population: 'Isolated mitochondria, primary astrocytes, Drosophila intestine and perfused mouse heart.'
              result: 'S1QEL compounds suppressed site-IQ superoxide/H2O2 without inhibiting oxidative phosphorylation; protection was context-specific.'
              effect_magnitude: 'Study-specific direction retained; no pooled estimate or ordinary-food effective dose inferred.'
              evidence_summary: 'S1QEL compounds suppressed site-IQ superoxide/H2O2 without inhibiting oxidative phosphorylation; protection was context-specific.'
              limitations: 'Tool compounds are not dietary inputs; effects across models are not independent human replications.'
              retrieval_scope: 'Primary abstract retrieved from Europe PMC/PubMed; no unavailable full-method quantities inferred.'
              source_url: 'https://pubmed.ncbi.nlm.nih.gov/27667666/'
              publication_classification: 'primary-experimental'
