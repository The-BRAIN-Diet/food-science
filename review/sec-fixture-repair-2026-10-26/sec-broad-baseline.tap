        record:
          pmId: 'BRS6-FM1-PM2'
          recordVersion: 1
          lastEvidenceAssessmentDate: '2026-10-18'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          process: 'Codex SEC Pilot 2: bounded primary Methods/Results appraisal and Scite-assisted recovery, version 1; no human scientific review recorded'
          methodology:
            name: 'Existing SEC calibration rubric proposal'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
          stoppingRationale: 'Scite full-text retrieval and citation discovery were followed by publisher/repository searches. Full pivotal Methods/Results were recovered for all four Findings. Reviews, citation counts and supporting-citation labels were not counted as replication. Stop after recovering the load-bearing reports and the material null comparison; further broad searching is not proportionate to this pilot.'
          id: 'glycaemic-sf2-assessment-v1'
          findingId: 'PM2-F2'
          title: 'Fish-before-rice acute response'
          canonicalProposition: 'Fish before rice reduced within-meal glucose variability in the diabetes group.'
          proposition: 'Fish before rice reduced within-meal glucose variability in the diabetes group.'
          scopeNote: 'Twelve untreated adults with type 2 diabetes; boiled mackerel followed 15 minutes later by steamed rice versus the reverse order, crossover. Serial venous glucose standard deviation over -15 to 240 minutes, not daylong CGM variability. Ten healthy volunteers are a separate population.'
          factors:
            D: 2
            B: 1
            P: 1
            R: 0
          rawScore: 4
          adjustedScore: 4
          capRationale: 'No existing ceiling is triggered by Directness 2, Bias Protection 1 and Precision 1. Replication 0 receives no additional decrement: raw and adjusted 4/8.'
          rationale:
            D: 'The crossover directly tested the stated order, population and acute glucose-dispersion endpoint; no bridge to long-term variability is included.'
            B: 'Within-person fish/rice comparison controls stable confounding. Residual concerns include incompletely described concealment, unblinded meals and the reported rank-sum analysis for paired summary outcomes. The third-day meat condition was not equivalent randomised replication.'
            P: 'Reported mean glucose standard deviations were 1.94 versus 2.77 mmol/L (standard errors 0.22 and 0.24). This supports the acute direction but leaves magnitude and applicability uncertain; no paired difference interval was extracted. Healthy-group dispersion was not significantly reduced and later glucose was higher with fish first.'
            R: 'Only one supporting empirical line for the exact population, protocol and endpoint was verified after bounded primary-source and Scite citation screening. Independent replication was not established in this assessment. This is not a claim that replication is absent from the entire literature; related protocols do not earn replication credit automatically.'
          limitations:
            0: 'Single small, acute sequence-specific diabetes crossover; no daylong or neurocognitive inference.'
            1: 'Meat-first results are contextual within the same study, not an independent dataset or proof of a fish-specific nutrient effect.'
          sources:
            supporting:
              0: 'kuwata_meal_sequence_2016'
            contradictory:
            contextual:
            contradictoryAssessment: 'The healthy comparison was null for dispersion and the late response differed from the early response. Neither proves the diabetes result false; both prohibit generalising it to every population or time point.'
            targetedChecks:
              0:
                doi: '10.1007/s00125-015-3841-z'
                role: 'Supporting; within-study population/time boundaries'
                access: 'Scite full text, Methods and Results appraised'
                assessment: 'Exact fish/rice comparison retained. No broad dietary-pattern, fish-oil or precise alternative food recommendation is inferred.'
            retrievalLimited:
          recommendation: 'Clarify separately, if approved: name the untreated diabetes population, 15-minute fish/rice sequence and four-hour sampling window. Do not label this daylong variability regulation.'
          history:
            0:
              date: '2026-10-18'
              decision: 'Initial Codex-assessed provisional 4/8 for the acute sequence-specific claim, with healthy null and late-response boundaries preserved.'
          previousAssessments:
