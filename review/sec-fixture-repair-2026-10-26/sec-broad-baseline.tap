      69:
        record:
          id: 'brs4-pm4-pm4-f1-sec'
          recordVersion: 1
          pmId: 'BRS4-FM2-PM4'
          findingId: 'PM4-F1'
          title: 'Mitochondrial oxidant production is source- and state-dependent'
          proposition: 'Specific mitochondrial electron-transfer sites generate superoxide and hydrogen peroxide; source-specific suppression can reduce oxidant production without inhibiting oxidative phosphorylation. Succinate oxidation during reperfusion can drive excessive production through reverse electron transport.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          lastEvidenceAssessmentDate: '2026-10-24'
          recordedOn: '2026-10-24'
          process: 'Codex bounded PM4/PM5 SEC completion v1: exact propositions, primary full-text recovery, factor-specific appraisal, scoped independence and explicit unresolved judgements; no human scientific-review status inferred.'
          methodology:
            name: 'Existing SEC four-factor anchors and integrated caps'
            version: '2026-10-24-pm4-pm5-v1'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html#sec-assessment-status'
          factors:
            D: 2
            B: 1
            P: 1
            R: 1
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rationale:
            D: 'Brand site-selective suppressors and Chouchani reperfusion perturbations test source generation, respiration and reverse-electron-transport endpoints in the stated experimental models (Brand Figs 1–2, 5; Chouchani Figs 2–4). No food or human efficacy proposition is scored.'
            B: 'Source counterscreens and respiration controls limit nonspecific inhibition, and reperfusion experiments add tracer/pharmacological checks. Tool selectivity and between-model transfer remain material residual concerns; this is not a fully bias-protected dietary trial.'
            P: 'Dose-response/selectivity and respiratory measurements discriminate source suppression from generalized inhibition. The limits of selectivity and translation across preparations leave uncertainty in effect size and applicable source boundaries; P2 is not established.'
            R: 'The two research programmes provide partially matching evidence for source-dependent complex-I oxidant regulation. They do not independently replicate every component of this composite Finding; multiple models within Brand are not counted as independent research-group replication.'
          rawScore: 5
          adjustedScore: 5
          capRationale: 'No D1/B0/P0 ceiling applies; adjusted equals raw. No extra model-to-human penalty is added because the proposition remains model-specific.'
          limitations:
            0: 'Experimental suppressors and ischaemia models establish source regulation, not dietary effectiveness. These results do not imply that all mitochondrial ROS are harmful or that mitochondrial emission assays isolate gross production.'
          sources:
            supporting:
              0: 'brs4_brand2016_20261023'
              1: 'brs4_chouchani2014_20261023'
            contextual:
            targetedChecks:
              0:
                doi: '10.1016/j.cmet.2016.08.012'
                role: 'supporting exact scoped proposition'
                access: 'full text HTML recovered'
                assessment: 'S1QEL compounds suppressed site-IQ superoxide/H2O2 without inhibiting oxidative phosphorylation; protection was context-specific. Tool compounds are not dietary inputs; effects across models are not independent human replications.'
              1:
                doi: '10.1038/nature13909'
                role: 'supporting exact scoped proposition'
                access: 'full text XML recovered'
                assessment: 'Accumulated succinate oxidation on reperfusion drove complex-I reverse-electron-transport ROS and injury. Pathological reperfusion is not a meal experiment; the origin of ischaemic succinate has been debated in subsequent primary work. No dietary succinate advice follows.'
            retrievalLimited:
            contradictoryAssessment: 'No exact-proposition contradiction was established in this bounded appraisal. Nonmatching endpoints and tissue/exposure limits remain explicit; this is not an exhaustive absence-of-contradiction claim.'
          evidenceLocations:
            0: 'brand2016: Figures 1–2 selectivity/respiration counterscreens and Figure 5 perfused heart'
            1: 'chouchani2014: main Figures 2–4 and extended methods'
          history:
            0:
              date: '2026-10-24'
              decision: 'User authorised SEC completion for approved PM4/PM5 reassessment. New versioned assessment; propositions, admissions, original confidence storage and all prior SEC records preserved. This is not qualified human scientific review.'
        sha256: 'd07ccb292a479016ed8f9d7735fc79c3d3e6d00154c39a2fec0010914362a46b'
      70:
        record:
          id: 'brs4-pm4-pm4-f2-sec'
          recordVersion: 1
          pmId: 'BRS4-FM2-PM4'
          findingId: 'PM4-F2'
          title: 'Mitochondrial ROS can carry adaptive signals'
          proposition: 'Complex-III-dependent oxidant signals contribute to hypoxic HIF stabilisation in tested cell systems. Mitochondrial ROS therefore have physiological signalling roles as well as injury-associated roles.'
          assessmentStatus: 'not-scored'
          assessmentComplete: false
          lastEvidenceAssessmentDate: '2026-10-24'
          recordedOn: '2026-10-24'
          process: 'Codex bounded PM4/PM5 SEC completion v1: exact propositions, primary full-text recovery, factor-specific appraisal, scoped independence and explicit unresolved judgements; no human scientific-review status inferred.'
          methodology:
            name: 'Existing SEC four-factor anchors and integrated caps'
            version: '2026-10-24-pm4-pm5-v1'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html#sec-assessment-status'
          factors:
            D: 2
          factorStates:
            D: 'established'
            B: 'unresolved'
            P: 'unresolved'
            R: 'unresolved'
          rationale:
            D: 'Guzy directly perturbs complex III and measures hypoxic oxidant signalling and HIF in the cell context specified by the Finding.'
            B: 'The recovered abstract identifies genetic/pharmacological perturbations, but control performance and reporting protections in the load-bearing Guzy experiments have not been sufficiently appraised. This is a retrieval/assessment gap, not B0.'
            P: 'Figure-level uncertainty, assay discrimination and the extent of HIF suppression in Guzy were not recovered sufficiently to distinguish P1/P2 defensibly. An abstract reporting significance is not an uncertainty assessment.'
            R: 'Bell 2007 is a relevant complementary Qo-site investigation, but exact-proposition independence and the relationship to the Guzy model have not been fully assessed; no default R0 is assigned.'
          capRationale: 'No total calculated: essential unresolved factors remain; unknown is not zero.'
          limitations:
            0: 'Hypoxia differs from anoxia; pharmacological respiratory inhibition can perturb multiple sites. This is not evidence for indiscriminate ROS reduction or a dietary-to-brain benefit.'
            1: 'Recover Guzy figures/methods and appraise control performance and uncertainty; compare Bell/Guzy model and research dependencies before a complete SEC.'
          sources:
            supporting:
              0: 'brs4_guzy2005_20261023'
            contextual:
            targetedChecks:
              0:
                doi: '10.1016/j.cmet.2005.05.001'
                role: 'supporting exact scoped proposition'
                access: 'Primary abstract retrieved from Europe PMC/PubMed; no unavailable full-method quantities inferred.'
                assessment: 'Complex-III function and oxidant signalling were required for the tested hypoxic HIF response. Context-dependent cell signalling; not all oxygen-sensing pathways or physiological states require this mechanism.'
            retrievalLimited:
              0:
                url: 'https://pubmed.ncbi.nlm.nih.gov/16054089/'
                limitation: 'Recover Guzy figures/methods and appraise control performance and uncertainty; compare Bell/Guzy model and research dependencies before a complete SEC.'
            contradictoryAssessment: 'No exact-proposition contradiction was established in this bounded appraisal. Nonmatching endpoints and tissue/exposure limits remain explicit; this is not an exhaustive absence-of-contradiction claim.'
          evidenceLocations:
            0: 'Guzy 2005 primary abstract, PMID16054089'
            1: 'Bell 2007 primary abstract, PMID17562787 (targeted complementary check)'
          followUp: 'Recover Guzy figures/methods and appraise control performance and uncertainty; compare Bell/Guzy model and research dependencies before a complete SEC.'
          history:
            0:
              date: '2026-10-24'
              decision: 'User authorised SEC completion for approved PM4/PM5 reassessment. New versioned assessment; propositions, admissions, original confidence storage and all prior SEC records preserved. This is not qualified human scientific review.'
        sha256: '2e0c4f7188135fad0b46c6199760058ec29b1d0620eb9ca6207029ab1823afb3'
      71:
        record:
          id: 'brs4-pm4-pm4-f3-sec'
          recordVersion: 1
          pmId: 'BRS4-FM2-PM4'
          findingId: 'PM4-F3'
          title: 'High-fat exposure altered mitochondrial H2O2-emitting potential'
          proposition: 'A specified high-fat meal and short high-fat feeding period increased skeletal-muscle mitochondrial H2O2-emitting potential in a small human experiment; separate rodent perturbations supported a role for mitochondrial oxidants in insulin resistance.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          lastEvidenceAssessmentDate: '2026-10-24'
          recordedOn: '2026-10-24'
          process: 'Codex bounded PM4/PM5 SEC completion v1: exact propositions, primary full-text recovery, factor-specific appraisal, scoped independence and explicit unresolved judgements; no human scientific-review status inferred.'
          methodology:
            name: 'Existing SEC four-factor anchors and integrated caps'
            version: '2026-10-24-pm4-pm5-v1'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html#sec-assessment-status'
          factors:
            D: 2
            B: 1
            P: 1
            R: 0
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rationale:
            D: 'Anderson Fig. 6 tests the specified meal/short-feeding exposure and human muscle H2O2 emission. Its separate rodent interventions support the separately stated rodent clause, not human mediation.'
            B: 'Within-person baseline and validated emission/respirometry assays help attribution, but the sequential human feeding design lacks a randomized contemporaneous meal comparator; diet/time/order confounding remains. The scored statement is the observed experiment, not a causal replacement-diet claim.'
            P: 'Fig. 6 reports participant-level/sample-size context, mean/SEM and group comparisons; the rise is informative for the tested exposure. Nine men, assay-specific conditions and uncertain magnitude beyond this sample preclude P2. Rodent effects are not pooled with human precision.'
            R: 'Only one independent human feeding dataset supports the exact meal/five-day muscle-emission result in the bounded assessed body. The obese cross-section and rodent arms do not replicate that exposure/population proposition. R0 describes this scoped body, not proof of absence throughout the literature.'
          rawScore: 4
          adjustedScore: 4
          capRationale: 'No D1/B0/P0 ceiling applies; adjusted equals raw. No extra model-to-human penalty is added because the proposition remains model-specific.'
          limitations:
            0: 'Net H2O2 emission reflects production and scavenging under assay conditions. Human meal findings do not establish a specific ROS-generating site, benefit from a proposed replacement meal, effects of all dietary fats, brain outcomes or human causal mediation.'
          sources:
            supporting:
              0: 'brs4_anderson2009_20261023'
            contextual:
            targetedChecks:
              0:
                doi: '10.1172/jci37048'
                role: 'supporting exact scoped proposition'
                access: 'full text HTML recovered'
                assessment: 'After a meal providing >60% energy from fat and five days of high-fat feeding, muscle mitochondrial H2O2-emitting potential increased; rodent antioxidant manipulations preserved insulin sensitivity. The meal provided 35% of daily energy; post-meal biopsy was at four hours. Small non-randomised feeding sequence and assay-specific emission; rodent causality must not be assigned to the human cohort.'
            retrievalLimited:
            contradictoryAssessment: 'No exact-proposition contradiction was established in this bounded appraisal. Nonmatching endpoints and tissue/exposure limits remain explicit; this is not an exhaustive absence-of-contradiction claim.'
          evidenceLocations:
            0: 'Anderson 2009 Figure 6 and Human studies/Statistics'
          history:
            0:
              date: '2026-10-24'
              decision: 'User authorised SEC completion for approved PM4/PM5 reassessment. New versioned assessment; propositions, admissions, original confidence storage and all prior SEC records preserved. This is not qualified human scientific review.'
