      57:
        sha256: 'a368419e1fb989f5a6f520c0d8906dde9e28da63ca776d63f3c89d2aacbbf7cc'
        record:
          id: 'pm1-pm1-f5-assessment'
          recordVersion: 1
          pmId: 'BRS1-FM1-PM1'
          findingId: 'PM1-F5'
          title: 'Mincing changed dietary phenylalanine appearance in older men'
          proposition: 'In a randomised crossover study of ten older men, 135 g minced beef produced greater six-hour dietary phenylalanine appearance than the same quantity of steak. Total plasma essential-amino-acid concentrations and muscle protein synthesis did not differ detectably between preparations.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          factors:
            D: 2
            B: 1
            P: 1
            R: 0
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rawScore: 4
          adjustedScore: 4
          capRationale: 'Directness 2, Bias Protection 1 and Precision 1: no D1/B0/P0 ceiling applies. Replication 0 receives no extra decrement.'
          lastEvidenceAssessmentDate: '2026-10-18'
          rationale:
            D: 'Same-cut beef and isotope-labelled dietary phenylalanine directly test the exact older-men preparation proposition.'
            B: 'Randomised within-person design and matched source/quantity reduce confounding. Visible texture and consumption-time differences remain; concealment and assay masking were not demonstrated in recovered methods. No critical systematic error was established.'
            P: 'Reported tracer effect and standard errors support the directional finding, but n=10, no extracted paired interval and negative secondary outcomes limit magnitude and extrapolation; nulls are not scored as equivalence.'
            R: 'The bounded exact-protocol search and source appraisal yielded one empirical dataset; thesis/journal reports and other processing studies are not independent replications. Independent replication was not established in this assessment.'
          limitations:
            0: 'One small older-male trial; no independent replication of the exact matched-beef protocol was established in this assessment. No claim that all foods should be minced or that this improves attention.'
            1: "Evidence-confidence conclusions must distinguish limitations of the underlying scientific evidence from limitations of the framework's evidence retrieval and assessment. Absence of verified evidence within an assessment must not be represented as evidence of absence."
          sources:
            supporting:
              0: 'stage2-ref-pm1-pennings2013'
            contextual:
            contradictoryAssessment: 'Supporting and null outcomes are endpoint-specific. No detected total-amino-acid or muscle-synthesis advantage in the same experiment.'
            targetedChecks:
              0:
                doi: '10.3945/ajcn.112.051201'
                role: 'supporting; endpoint-specific nulls retained'
                access: 'Published abstract plus full experimental chapter 6 in the author institutional thesis; final published quantitative result cross-checked against author-shared publication.'
                assessment: 'Randomised crossover; ten older men, mean age 74 years; two visits at least 14 days apart. More dietary phenylalanine appeared after mincing. Total plasma essential-amino-acid concentrations and muscle synthesis did not differ detectably. Six-hour dietary phenylalanine appearance: minced 61% ± 3% versus steak 49% ± 3% (means ± SEM), P < 0.01; 12 percentage-point difference. No paired confidence interval calculated or inferred. Small single trial; mean estimates and standard errors available, paired effect interval not extracted; no equivalence claim for null outcomes. Single empirical dataset; thesis and journal article are the same experiment, not replications.'
            retrievalLimited:
              0:
                doi: '10.3945/ajcn.112.051201'
                url: 'https://cris.maastrichtuniversity.nl/ws/files/713025/guid-1eacd19b-df59-418a-86f9-f01719b9315f-ASSET1.0.pdf'
                limitation: 'Published abstract plus full experimental chapter 6 in the author institutional thesis; final published quantitative result cross-checked against author-shared publication. Effect: no unexamined methods, uncertainty or replication credited.'
          methodology:
            name: 'Synthesised Evidence Confidence: Directness + Bias Protection + Precision + Replication'
