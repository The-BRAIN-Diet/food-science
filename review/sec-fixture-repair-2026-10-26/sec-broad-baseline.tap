        record:
          id: 'brs6-pm8-pm8-f16-endocrine-assessment'
          recordVersion: 1
          pmId: 'BRS6-FM4-PM8'
          findingId: 'PM8-F16'
          assessmentStatus: 'codex-provisional'
          recordedOn: '2026-10-26'
          lastEvidenceAssessmentDate: '2026-10-26'
          process: 'Codex-assisted full Stage 2A/2B rerun; source compartments and publication classes assessed independently.'
          methodology:
            name: 'SEC calibration rubric proposal'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
          proposition: 'Hypocaloric weight-reduction programmes in women with obesity reduced ex vivo adipose leptin release, while adiponectin responses were depot-specific or unchanged.'
          canonicalProposition: 'Hypocaloric weight-reduction programmes in women with obesity reduced ex vivo adipose leptin release, while adiponectin responses were depot-specific or unchanged.'
          factors:
            D: 2
            B: 1
            P: 1
            R: 1
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rawScore: 5
          adjustedScore: 5
          rationale:
            D: '2 — Directness applies to the stated human tissue/culture or local measurement proposition, not a general dietary, brain or clinical claim.'
            B: '1 — Biopsy release assays directly test the scoped endpoint. The best recovered programme analysis pooled arms without an untreated comparator; selection, co-intervention and energy-balance/weight-loss confounding remain. Restricting the proposition to observed programme-associated release avoids a weight-independent causal claim.'
            P: '1 — Observed release changes and retained adiponectin null/depot differences narrow the qualitative conclusion. Small release subgroups, no common uncertainty interval and phase/depot variation leave important magnitude and applicability uncertainty. No clinical magnitude is inferred.'
            R: '1 — Independent You and Arvidsson samples confirm reduced ex vivo leptin release after hypocaloric weight-reduction programmes. Adiponectin null/depot differences and the multiphase Siklova response prevent full replication credit for a common endocrine effect. Acute meal/fasting experiments are context, not replication.'
          limitations:
            0: 'Energy deficit, weight loss and co-interventions are not fully separable. Ex vivo release, venous–arterial concentration difference, transcript and plasma measurements remain distinct. No universal optimal hormone direction, food attribution, brain benefit or weight-independent endocrine effect is established.'
            1: 'Provisional Codex SEC assessment, not human-approved and not a Dietary Confidence assessment.'
          sources:
            supporting:
              0: 'you_regional_release_2014'
              1: 'arvidsson_hypocaloric_secretion_2004'
              2: 'siklova_diet_phase_secretion_2012'
            contradictory:
            contextual:
              0: 'klein_leptin_fasting_2000'
              1: 'evans_meal_leptin_2001'
            contradictoryAssessment: 'Null, heterogeneous and depot-specific results are retained rather than removed; different compartments are not treated as interchangeable.'
            targetedChecks:
              0:
                doi: '10.1002/oby.20743'
                role: 'primary'
                access: 'Full primary Methods/Results/Discussion and figures recovered through Scite; all 21,177 body characters reviewed.'
                assessment: 'Weight loss 10.1 ± 0.7 kg. Leptin release decreased in both depots; adiponectin release increased only abdominally. Tissue and circulating changes were not significantly correlated. Release subgroup n=27, expression n=42. No untreated comparator for pooled analysis; exercise could not be isolated. Whole-tissue ex vivo release is not in vivo flux. Population, depot, weight loss and energy balance constrain interpretation.'
              1:
                doi: '10.2337/diabetes.53.8.1966'
                role: 'primary'
                access: 'Primary abstract and accessible journal/PDF excerpts; complete bias appraisal remains limited.'
                assessment: 'Approximately 7.5% weight loss and 40% lower leptin secretion; adiponectin secretion unchanged. Diet arms had similar responses. No weight-stable comparator; cannot separate energy deficit from weight loss. Adiponectin null qualifies You abdominal response; no macronutrient superiority. Tested deficit is a study exposure, not an effective-dose prescription.'
              2:
                doi: '10.1210/jc.2011-2380'
                role: 'primary'
                access: 'Primary abstract and metadata; full methods not independently recovered'
                assessment: 'Adipocyte-produced leptin measures fell during very-low-calorie feeding and rose during stabilisation; stromavascular adipokines followed different patterns. Uncontrolled multiphase programme; cellular source and energy-balance phase matter. Does not justify sustained maximisation of leptin suppression or a general very-low-calorie diet recommendation.'
              3:
                doi: '10.1152/ajpendo.2000.278.2.E280'
                role: 'primary'
                access: 'Primary abstract and metadata; full methods not independently recovered'
                assessment: 'Release declined in lean women but changed little in women with upper-body obesity. Small acute physiology experiment; fasting duration, time of day and energy balance not independently isolated. Does not validate a fasting protocol or universal lower-leptin target.'
              4:
                doi: '10.1042/cs1000493'
                role: 'primary'
                access: 'Primary abstract and metadata; full methods not independently recovered'
                assessment: 'Leptin venous–arterial difference fell after fat loads and rose after the mixed meal, peaking at 240 minutes. Different small cohorts, non-isolated carbohydrate, oral versus intravenous exposure. Concentration difference is not equivalent to fully quantified secretion flux. No optimal meal or carbohydrate requirement established.'
            retrievalLimited:
              0:
                url: 'https://doi.org/10.2337/diabetes.53.8.1966'
                limitation: 'Primary abstract and accessible journal/PDF excerpts; complete bias appraisal remains limited.'
              1:
                url: 'https://doi.org/10.1210/jc.2011-2380'
                limitation: 'Primary abstract and metadata; full methods not independently recovered'
              2:
                url: 'https://doi.org/10.1152/ajpendo.2000.278.2.E280'
                limitation: 'Primary abstract and metadata; full methods not independently recovered'
              3:
                url: 'https://doi.org/10.1042/cs1000493'
                limitation: 'Primary abstract and metadata; full methods not independently recovered'
          history:
