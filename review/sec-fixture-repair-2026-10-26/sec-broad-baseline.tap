      - atom_id: PM3-KC1-UPSTREAM-2
        dietary_input: true
        dietary_input_note: "Accepted upstream dietary constituent provision is distinct from the pool/constraint reference. Existing role, conditional scope and limitations remain unchanged."
        input: Betaine
        input_type: supported upstream supply
        biological_role: >-
          Betaine donates a methyl group through [PM2 — Betaine/BHMT
          remethylation](/docs/biological-targets/brs2/fm1/brs2-fm1-pm2-betaine-bhmt-remethylation)
          to regenerate methionine used by PM3.
        evidence_source:
          finding_ids:
