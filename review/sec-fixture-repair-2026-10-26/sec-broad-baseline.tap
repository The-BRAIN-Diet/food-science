        record:
          id: 'pm1-pm1-f2-assessment'
          recordVersion: 1
          pmId: 'BRS1-FM1-PM1'
          findingId: 'PM1-F2'
          title: 'Diet-wide amino-acid adequacy does not require identical complete meals'
          proposition: 'Varied adult diets can provide digestible indispensable amino acids without requiring every meal to supply the full set. This nutritional-adequacy proposition does not establish an optimal neurotransmitter dose or demonstrate that all plant and animal foods have identical postprandial responses.'
          assessmentStatus: 'not-scored'
          assessmentComplete: false
          factors:
          factorStates:
            D: 'unresolved'
            B: 'unresolved'
            P: 'unresolved'
            R: 'unresolved'
          capRationale: 'No total calculated; biochemical provenance or incompletely appraised adequacy is not missing evidence scored zero.'
          unscoredReason: 'Nutritional adequacy synthesis retained; no complete primary-study D/B/P/R assessment of the same whole-diet proposition.'
          lastEvidenceAssessmentDate: '2026-10-18'
          rationale:
            D: 'Established scope or biochemical identity is documented, but no complete four-factor numerical assessment is asserted.'
            B: 'No source-count-derived score; source-specific design appraisal is not complete for this exact nonexperimental synthesis.'
            P: 'No invented quantitative precision for a curated reaction or general adequacy statement.'
            R: 'Database agreement and reviews are not independent experimental replications.'
          limitations:
            0: 'Requirement reviews are not direct tests of neurotransmitter response or every possible plant diet. Energy sufficiency, variety, age and clinical context remain relevant.'
            1: "Evidence-confidence conclusions must distinguish limitations of the underlying scientific evidence from limitations of the framework's evidence retrieval and assessment. Absence of verified evidence within an assessment must not be represented as evidence of absence."
          sources:
            supporting:
              0: 'mariotti_dietary_2019'
              1: 'moughan_diaas_2024'
              2: 'marsh_protein_2013'
              3: 'stage2-ref-pm1-requirements2025'
              4: 'stage2-ref-pm1-faba2024'
              5: 'stage2-ref-pm1-nonanimal2024'
            contextual:
            contradictoryAssessment: 'Supporting and null outcomes are endpoint-specific. No literature-wide absence assertion.'
            targetedChecks:
              0:
                doi: '10.1016/j.ajcnut.2025.04.017'
                role: 'contextual; quantitative requirement uncertainty'
                access: 'Publisher abstract and AHRQ/NCBI report discovery recovered. Journal full text unavailable through Scite; no quantitative tables assumed read.'
                assessment: 'Systematic review of studies January 2000-May 2024; duplicate screening and risk-of-bias appraisal. Evidence gaps in exact requirement estimates do not negate indispensable-amino-acid biology.  Not a PM-specific intake prescription, postprandial tracer experiment or neurotransmitter trial. Review plus included studies are not independent replications.'
              1:
                doi: '10.1017/S0007114524000163'
                role: 'supporting; contradicts a universal animal-over-plant hierarchy'
                access: 'Scite full-text Methods and Results, including randomisation, washout, assays, power and multiplicity; published Cambridge PDF checked.'
                assessment: 'Independent Exeter programme; randomised double-blind six-period crossover, 12 young and 10 older adults, both sexes. Source-specific plasma profiles; some non-animal sources produced higher essential-amino-acid responses than the tested milk beverage. Integrated responses did not show a uniform age decrement.  Small cohorts; composition and food matrix differ, so no isolated digestibility estimate or universal ranking follows. Independent of Maastricht pooled dairy corpus; age analyses and six visits within a person are not six independent replications.'
            retrievalLimited:
              0:
                doi: '10.1016/j.ajcnut.2025.04.017'
                url: 'https://doi.org/10.1016/j.ajcnut.2025.04.017'
                limitation: 'Publisher abstract and AHRQ/NCBI report discovery recovered. Journal full text unavailable through Scite; no quantitative tables assumed read. Effect: no unexamined methods, uncertainty or replication credited.'
              1:
                url: 'https://pubmed.ncbi.nlm.nih.gov/38311065/'
                limitation: 'Full published abstract examined; detailed methods not scored. Effect: no unexamined methods, uncertainty or replication credited.'
