      66:
        sha256: '90eb26db799a67f9ad9bb5c86217da26d65c1260901c23df9bc21710f3dfa013'
        record:
          id: 'lat1-pm2-f2-assessment'
          recordVersion: 2
          pmId: 'BRS1-FM1-PM2'
          findingId: 'PM2-F2'
          title: 'Meal composition and protein source alter plasma precursor ratios'
          proposition: 'In the studied healthy adults, meal composition and tested protein sources can alter plasma tryptophan relative to competing large neutral amino acids; the direction and tyrosine response depend on the exposure and sampling context, without establishing increased human brain transport or neurotransmitter synthesis.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          lastEvidenceAssessmentDate: '2026-10-19'
          process: 'Codex bounded Stage 2A/2B appraisal; full-text recovery and proposition-level SEC assessment. No human scientific review recorded.'
          methodology:
            name: 'SEC calibration rubric, existing D/B/P/R anchors and caps'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
            version: 'Source snapshot SHA-256 304dfe0a2bb08c0c95bf88677371957cab4b8b2365150941e840648ef544cb9a'
          factors:
            D: 2
            B: 1
            P: 1
            R: 1
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rawScore: 5
          adjustedScore: 5
          capRationale: 'D2: no inferential cap for the plasma proposition. No B0/P0 cap applies. R1 limits replication credit; no extra deduction.'
          rationale:
            D: '2/2: controlled feeding studies measure the scoped plasma ratio directly. Human brain uptake and benefit are explicitly excluded.'
            B: '1/2: Wurtman randomised meal order, used objective assays and order-adjusted/multiplicity-aware analysis. Visible meals, one incomplete participant and incompletely established protections in historical and protein-source studies leave residual concerns; no critical bias is demonstrated.'
            P: '1/2: source-specific contrasts and reported SEM/ranges distinguish a meal effect in tested conditions. Small samples, heterogeneous protocols and limited paired uncertainty leave materially different magnitudes and boundaries plausible. Null experiments are not equivalence results.'
            R: '1/2: separate investigator groups and datasets corroborate plasma meal responsiveness, but protocol/denominator differences and credible evening/starch nulls preclude full replication credit. This is not independent replication of one exact meal protocol.'
          limitations:
            0: 'Small acute healthy-adult samples; different meals, ratio denominators and sampling windows; incomplete historical methods retrieval. No population-wide optimum or direct human brain-flux estimate. Evening null results limit generalisation but are not equivalence evidence.'
            1: 'Evidence-confidence conclusions distinguish scientific limitations from retrieval limitations. No human expert review or PM-wide Reviewed status is inferred.'
          sources:
