ns":"Small secondary effects without multiplicity adjustment; short washout permits carryover. Not evidence for gentle walking or lasting clinical benefit.","retrieval_scope":"Full primary Methods/Results","effect_magnitude":"Primary mean difference -0.2 mmol/L (95% CI -0.4 to 0; p=0.07). Secondary SD -0.1 mmol/L, CV -1 percentage point and MAGE -0.3 mmol/L; time in range was null.","evidence_summary":"Primary mean difference -0.2 mmol/L (95% CI -0.4 to 0; p=0.07). Secondary SD -0.1 mmol/L, CV -1 percentage point and MAGE -0.3 mmol/L; time in range was null. Small secondary effects without multiplicity adjustment; short washout permits carryover. Not evidence for gentle walking or lasting clinical benefit."},"citation_key":"stage2-ref-babir","canonical_reference":{"author_year":"Babir et al. (2026)","number":11,"anchor":"#pm-ref-11"}}],"sec_assessment_ref":{"id":"glycaemic-f8-assessment-v1","version":2,"sha256":"d6ff93c65397da5a2622e9f88bdb6c632f0b895674cc0162fd4a606cd391ae33"},"connected_supportive_evidence":[]}} pmId={"BRS6-FM1-PM2"} />
    
