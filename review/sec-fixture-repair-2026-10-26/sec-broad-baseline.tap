            evidence_source: bounded-external-search
            directional_finding: Greater excursions correlated with oxidative-stress marker excretion.
            study_exposure: Observational type 2 diabetes CGM and urinary isoprostane comparison.
            study_finding: Greater excursions correlated with oxidative-stress marker excretion.
            assessment:
              study: Observational type 2 diabetes CGM and urinary isoprostane comparison.
              population: Observational type 2 diabetes CGM and urinary isoprostane comparison.
              result: Greater excursions correlated with oxidative-stress marker excretion.
              effect_magnitude: Only source-extracted comparisons retained; no pooled benefit estimate.
              evidence_summary: Greater excursions correlated with oxidative-stress marker excretion.
              limitations: Do not label this an induced-glucose-fluctuation experiment; inherited key has a wrong PMID.
              retrieval_scope: Primary abstract/results retrieved; full methods not independently extracted unless noted.
              source_url: 'https://pubmed.ncbi.nlm.nih.gov/16609090/'
