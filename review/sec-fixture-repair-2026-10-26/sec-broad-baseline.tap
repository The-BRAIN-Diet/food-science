    <ScientificFinding finding={{"id":"PM2-F7","finding_label":"Interval walking and glucose variability","finding_statement":"Two weeks of the tested supervised interval-walking programme reduced mean amplitude of glycaemic excursions (MAGE) versus an inactive control period in a small type 2 diabetes crossover trial.","finding_summary":"Two weeks of the tested supervised interval-walking programme reduced mean amplitude of glycaemic excursions (MAGE) versus an inactive control period in a small type 2 diabetes crossover trial.","synthesis":"MAGE decreased 1.7 +/- 0.4 mmol/L within interval training; interval/control comparison p=0.01. Within-period mean glucose was inconclusive (p=0.08). Small unmasked trial, baseline imbalance and missing sensor record; oxidative-stress markers did not improve. No blanket superiority to all continuous exercise.","synthesis_limitations":"Small unmasked trial, baseline imbalance and missing sensor record; oxidative-stress markers did not improve. No blanket superiority to all continuous exercise.","synthesised_evidence_confidence":"not-yet-scored","evidence_considered":[{"label":"Karstoft et al. (2017)","href":"#stage2-ref-karstoft","data_level":"Human Study","evidence_source":"bounded-external-search","directional_finding":"MAGE decreased 1.7 +/- 0.4 mmol/L within interval training; interval/control comparison p=0.01. Within-period mean glucose was inconclusive (p=0.08).","assessment":{"study":"Randomised crossover: ten supervised 60-minute sessions over two weeks, alternating three-minute slower/faster walking; continuous and inactive comparator periods, multiweek washout.","population":"14 adults with type 2 diabetes; 13 usable CGM records.","result":"MAGE decreased 1.7 +/- 0.4 mmol/L within interval training; interval/control comparison p=0.01. Within-period mean glucose was inconclusive (p=0.08).","limitations":"Small unmasked trial, baseline imbalance and missing sensor record; oxidative-stress markers did not improve. No blanket superiority to all continuous exercise.","retrieval_scope":"Full publisher PDF Methods, Table 1 and Results","effect_magnitude":"MAGE decreased 1.7 +/- 0.4 mmol/L within interval training; interval/control comparison p=0.01. Within-period mean glucose was inconclusive (p=0.08).","evidence_summary":"MAGE decreased 1.7 +/- 0.4 mmol/L within interval training; interval/control comparison p=0.01. Within-period mean glucose was inconclusive (p=0.08). Small unmasked trial, baseline imbalance and missing sensor record; oxidative-stress markers did not improve. No blanket superiority to all continuous exercise."},"citation_key":"stage2-ref-karstoft","canonical_reference":{"author_year":"Karstoft et al. (2017)","number":10,"anchor":"#pm-ref-10"}}],"sec_assessment_ref":{"id":"glycaemic-f7-assessment-v1","version":2,"sha256":"5a9e2332642abccb1d7cc7fb4f8ba330d17f0593dcafed4ac3a28c063f58d0a3"},"connected_supportive_evidence":[]}} pmId={"BRS6-FM1-PM2"} />
    
