    lifestyle_priorities:
    scientific_findings_intro: 'The evidence separates three links: retinal photoreception, phase resetting by timed light, and acute suppression of melatonin. Human phase measurements support the entrainment scope; the suppression comparison alone does not. Evening eReader exposure also affected sleep onset and next-morning alertness. Animal photopigment evidence identifies machinery without establishing an extra-intake benefit.'
  actual:
    title: 'Light–Dark Circadian Entrainment'
    pm_id: 'BRS-X(Circadian-FM1-PM1)'
    mission: 'Synchronise the central circadian clock with the external light–dark cycle through retinal light signals.'
    parent_fm: 'BRS-X(Circadian-FM1)'
    parent_brs: 'BRS-X(Circadian)'
    summary: 'Light reaching the retina provides a timing signal that helps the central circadian clock track the day–night cycle. Timed light can shift circadian phase; light before bedtime can also suppress the nightly melatonin signal. These are different effects. Practical support therefore concerns the timing and characteristics of light exposure, with the direction of a phase shift depending on internal clock timing.'
    key_constraints:
    cofactors:
    intervention_dominance: 'Lifestyle-Dominant'
    intervention_breakdown: 'Behavioural/Lifestyle Dominant'
    timing_specific: 'Yes'
    dose_sensitivity: 'The comparison is evening room light versus dim light. It is not a lux target, a screen rule, or a daylight prescription.'
    references:
      0: '[Gooley et al. (2011) — Exposure to room light before bedtime suppresses melatonin onset and shortens melatonin duration in humans](/docs/papers/BRAIN-Diet-References#gooley_room_light_2011)'
      1: '[Khalsa et al. (2003) — A phase response curve to single bright light pulses in human subjects](/docs/papers/BRAIN-Diet-References#khalsa_light_phase_2003)'
      2: '[Chang et al. (2015) — Evening use of light-emitting eReaders negatively affects sleep, circadian timing, and next-morning alertness](/docs/papers/BRAIN-Diet-References#chang_ereader_circadian_2015)'
      3: '[Berson et al. (2002) — Phototransduction by retinal ganglion cells that set the circadian clock](/docs/papers/BRAIN-Diet-References#berson_retinal_clock_2002)'
      4: '[Fu et al. (2005) — Intrinsically photosensitive retinal ganglion cells detect light with a vitamin A-based photopigment, melanopsin](/docs/papers/BRAIN-Diet-References#fu_melanopsin_chromophore_2005)'
      5: '[Fargason et al. (2017) — Correcting delayed circadian phase with bright light therapy predicts improvement in ADHD symptoms: A pilot study](/docs/papers/BRAIN-Diet-References#fargason_light_adhd_2017)'
      6: '[Thompson et al. (2001) — Vitamin A deprivation and acute SCN light signalling](/docs/papers/BRAIN-Diet-References#thompson_vitamin_a_photic_signalling_2001)'
    hide_title: true
    list_image: '/img/biological-targets/brs-x-circadian-portrait-thumbnail.jpg'
    scientific_findings:
      0:
        id: 'PM1-F1'
        finding_label: 'Evening room light suppresses and shortens melatonin secretion'
        presentation: 'mechanistic-basis'
        fm_rollup: true
        finding_summary: 'In a retrospective analysis of 116 healthy adults aged 18–30, room light before bedtime suppressed melatonin and shortened its duration by about 90 minutes relative to dim light.'
        finding_statement: 'In a retrospective analysis of 116 healthy adults aged 18–30, room light before bedtime suppressed melatonin and shortened its duration by about 90 minutes relative to dim light.'
        finding_interpretation: 'The exposure changes a central-clock output. Acute suppression is not the same as resetting clock phase, and it is not a cortisol result.'
        synthesis: 'The room-light comparison establishes acute melatonin suppression and shorter secretion. It does not by itself establish a lasting shift of the pacemaker.'
        synthesis_limitations: 'Indoor laboratory illumination is not identical to every screen or to daylight. Acute suppression does not establish a durable phase correction.'
        synthesised_evidence_confidence: 'not-yet-scored'
        evidence_considered:
          0:
            label: 'Gooley et al. (2011)'
            citation_key: 'gooley_room_light_2011'
            href: '/docs/papers/BRAIN-Diet-References#gooley_room_light_2011'
            data_level: 'Human Mechanistic'
            evidence_source: 'repository-inherited'
            directional_finding: 'Room light suppressed and shortened melatonin secretion.'
            assessment:
              study: 'Retrospective analysis of two laboratory studies; room light below 200 lux versus dim light below 3 lux in the eight hours before bedtime.'
              population: '116 healthy volunteers aged 18–30.'
              result: 'Later melatonin onset in 99% of participants and approximately 90 minutes shorter secretion duration.'
              effect_magnitude: 'Approximately 90 minutes shorter melatonin duration; acute suppression is distinct from phase resetting.'
              evidence_summary: 'Evening room light changed a central melatonin signal relative to dim light.'
              limitations: 'The comparison is not every screen, not daylight, and not a cortisol measurement.'
      1:
        id: 'PM1-F2'
        finding_label: 'Timed light changes circadian phase as well as melatonin secretion'
        presentation: 'mechanistic-basis'
        fm_rollup: true
        finding_summary: 'Human light exposures can advance or delay circadian phase, depending on their timing.'
        finding_statement: 'Human light exposures can advance or delay circadian phase, depending on their timing.'
        finding_interpretation: 'Khalsa measured pre/post melatonin phase under constant routines, providing phase-resetting evidence distinct from suppression. Chang provides a separate evening device comparison with delayed circadian timing, sleep and next-morning alertness effects. Neither specifies one best schedule for everyone.'
        synthesis: 'Khalsa measured pre/post melatonin phase under constant routines, providing phase-resetting evidence distinct from suppression. Chang provides a separate evening device comparison with delayed circadian timing, sleep and next-morning alertness effects. Neither specifies one best schedule for everyone. Fargason provides a selected ADHD pilot with a measured phase advance, alongside correlated symptom change.'
        synthesis_limitations: 'Timing relative to internal phase, exposure duration, intensity and prior light history matter; laboratory bright-light and eReader protocols are not interchangeable. The uncontrolled ADHD pilot combined morning light and evening restriction and cannot establish symptom mediation or a universal treatment effect.'
        synthesised_evidence_confidence: 'not-yet-scored'
        evidence_considered:
          0:
            label: 'Khalsa et al. (2003)'
            citation_key: 'khalsa_light_phase_2003'
            href: '/docs/papers/BRAIN-Diet-References#khalsa_light_phase_2003'
            data_level: 'Human Mechanistic'
            evidence_source: 'bounded-external-search'
            directional_finding: 'The melatonin-midpoint phase-response curve had a 5.02-hour peak-to-trough amplitude, with advances and delays depending on exposure phase.'
            assessment:
              study: '21 healthy adults; 6.7-hour bright-light pulse scheduled across circadian phases; pre/post dim-light constant routines.'
              population: '21 healthy adults; 6.7-hour bright-light pulse scheduled across circadian phases; pre/post dim-light constant routines.'
              result: 'The melatonin-midpoint phase-response curve had a 5.02-hour peak-to-trough amplitude, with advances and delays depending on exposure phase.'
              effect_magnitude: 'The melatonin-midpoint phase-response curve had a 5.02-hour peak-to-trough amplitude, with advances and delays depending on exposure phase.'
              evidence_summary: 'The melatonin-midpoint phase-response curve had a 5.02-hour peak-to-trough amplitude, with advances and delays depending on exposure phase.'
              limitations: 'A single long pulse establishes phase resetting, not a universal daily treatment schedule or durable health benefit.'
              retrieval_scope: 'Primary abstract retrieved; no unextracted full-method detail asserted.'
              source_url: 'https://physoc.onlinelibrary.wiley.com/doi/10.1113/jphysiol.2003.040477'
          1:
            label: 'Chang et al. (2015)'
            citation_key: 'chang_ereader_circadian_2015'
            href: '/docs/papers/BRAIN-Diet-References#chang_ereader_circadian_2015'
            data_level: 'Human Mechanistic'
            evidence_source: 'bounded-external-search'
            directional_finding: 'eReader exposure delayed measured circadian timing, reduced melatonin secretion, prolonged sleep onset and reduced next-morning alertness.'
            assessment:
              study: 'Controlled light-emitting eReader versus printed-book comparison before bedtime.'
              population: 'Controlled light-emitting eReader versus printed-book comparison before bedtime.'
              result: 'eReader exposure delayed measured circadian timing, reduced melatonin secretion, prolonged sleep onset and reduced next-morning alertness.'
              effect_magnitude: 'eReader exposure delayed measured circadian timing, reduced melatonin secretion, prolonged sleep onset and reduced next-morning alertness.'
              evidence_summary: 'eReader exposure delayed measured circadian timing, reduced melatonin secretion, prolonged sleep onset and reduced next-morning alertness.'
              limitations: 'Specific device/exposure conditions; does not establish that every screen or a shorter exposure produces the same effect.'
              retrieval_scope: 'Primary abstract retrieved; no unextracted full-method detail asserted.'
              source_url: 'https://pubmed.ncbi.nlm.nih.gov/25535358/'
          2:
            label: 'Fargason et al. (2017)'
            citation_key: 'fargason_light_adhd_2017'
            href: '/docs/papers/BRAIN-Diet-References#fargason_light_adhd_2017'
            data_level: 'Human Mechanistic'
            evidence_source: 'bounded-external-search'
            directional_finding: 'Morning bright light with reduced evening light advanced DLMO by 31 minutes and mid-sleep by 57 minutes in adults with ADHD.'
            assessment:
              study: 'Uncontrolled two-week pilot added to standard care; morning bright light plus evening light restriction.'
              population: 'Adults with ADHD; actigraphic sleep comparison reported in a subset of eight phase responders.'
              result: 'Phase advances correlated with reduced ADHD symptom scores.'
              effect_magnitude: 'DLMO advance 31 minutes; mid-sleep advance 57 minutes.'
              evidence_summary: 'Supports phase shifting in a selected ADHD sample.'
              limitations: 'No control group; combined light changes; medication and expectancy confounding. Nonsignificant sleep changes do not establish sleep-independent mediation.'
              source_url: 'https://pubmed.ncbi.nlm.nih.gov/28327443/'
              retrieval_scope: 'Primary abstract and available methods excerpts reviewed.'
        connected_supportive_evidence:
      2:
        id: 'PM1-F3'
        finding_label: 'Retinal photoreception supplies the light signal to the central clock'
        presentation: 'mechanistic-basis'
        fm_rollup: true
        finding_summary: 'Intrinsically photosensitive retinal ganglion cells provide a biological route for retinal light signals; melanopsin photosensitivity depends on a vitamin A-based chromophore.'
        finding_statement: 'Intrinsically photosensitive retinal ganglion cells provide a biological route for retinal light signals; melanopsin photosensitivity depends on a vitamin A-based chromophore.'
        finding_interpretation: 'Retinal recordings establish intrinsic phototransduction. Fu found reduced photosensitivity in Rpe65-deficient mice and rescue with a retinal analogue. This is biochemical resource evidence; retinal light dosing and dietary vitamin A applicability remain separate propositions.'
        synthesis: 'Retinal recordings establish intrinsic phototransduction. Fu found reduced photosensitivity in Rpe65-deficient mice and rescue with a retinal analogue. This is biochemical resource evidence; retinal light dosing and dietary vitamin A applicability remain separate propositions.'
        synthesis_limitations: 'Animal/cellular machinery and chromophore rescue do not quantify a dietary vitamin A requirement for adult human entrainment or prove benefit from additional intake.'
        synthesised_evidence_confidence: 'not-yet-scored'
        evidence_considered:
          0:
