    <ScientificFinding finding={{"id":"PM2-F6","finding_label":"Early eating and glucose variability","finding_statement":"In a small prediabetes crossover, the tested early, front-loaded eating schedule reduced mean amplitude of glycaemic excursions (MAGE) over six days versus later calorie distribution; mean glucose and several other variability/range measures were inconclusive.","finding_summary":"In a small prediabetes crossover, the tested early, front-loaded eating schedule reduced mean amplitude of glycaemic excursions (MAGE) over six days versus later calorie distribution; mean glucose and several other variability/range measures were inconclusive.","synthesis":"MAGE 2.4 versus 2.9 mmol/L (p=0.001); mean glucose, SD and time 70-180 mg/dL were not significantly different. Small sample, no washout; timing, eating-window length and calorie distribution cannot be separated.","synthesis_limitations":"Small sample, no washout; timing, eating-window length and calorie distribution cannot be separated.","synthesised_evidence_confidence":"not-yet-scored","evidence_considered":[{"label":"Bruno et al. (2024)","href":"#stage2-ref-bruno","data_level":"Human Study","evidence_source":"bounded-external-search","directional_finding":"MAGE 2.4 versus 2.9 mmol/L (p=0.001); mean glucose, SD and time 70-180 mg/dL were not significantly different.","assessment":{"study":"Six days of matched weight-maintenance food: 08:00-16:00, 80% of calories before 14:00, versus usual later distribution; randomised crossover without washout.","population":"10 adults with prediabetes and overweight/obesity.","result":"MAGE 2.4 versus 2.9 mmol/L (p=0.001); mean glucose, SD and time 70-180 mg/dL were not significantly different.","limitations":"Small sample, no washout; timing, eating-window length and calorie distribution cannot be separated.","retrieval_scope":"Full primary Methods/Results","effect_magnitude":"MAGE 2.4 versus 2.9 mmol/L (p=0.001); mean glucose, SD and time 70-180 mg/dL were not 