          pmId: 'BRS1-FM1-PM1'
          findingId: 'PM1-F3'
          title: 'Phenylalanine-to-tyrosine conversion: biochemical provenance'
          proposition: 'Phenylalanine-4-hydroxylase (PAH) converts L-phenylalanine to L-tyrosine. This endogenous route contributes to tyrosine supply but does not make tyrosine absent from foods or establish an independent requirement for extra dietary tyrosine.'
          assessmentStatus: 'not-scored'
          assessmentComplete: false
          factors:
