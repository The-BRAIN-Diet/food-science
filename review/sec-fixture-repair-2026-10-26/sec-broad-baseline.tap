          children: "Dietary protein supplies the circulating precursor pool; food structure and source can alter delivery kinetics without proving superior neurotransmitter function. Curated reaction identity, whole-diet adequacy and experimental intervention findings are distinguished below."
        }), "\n", _jsx(ScientificFinding, {
          finding: {
            "id": "PM1-F1",
            "finding_label": "Dietary protein and amino-acid availability",
            "presentation": "mechanistic-basis",
            "fm_rollup": true,
            "finding_summary": "Human tracer studies establish dietary delivery. Cross-study source/dose comparisons and variable age results require qualified interpretation.",
            "finding_interpretation": "Scope is circulating provision and the exact measured endpoint, not brain entry, neurotransmitter efficacy or a clinical recommendation.",
            "finding_statement": "Dietary protein supplies phenylalanine to the human circulation, with delivery kinetics varying by the tested protein source, dose and meal context. The pooled age association is context-dependent, not proof that ageing uniformly impairs absorption or that greater availability increases brain neurotransmitters.",
            "synthesised_evidence_confidence": "not-yet-scored",
            "synthesis": "The pooled dairy corpus establishes dietary tracer appearance but is not 18 independent research-group replications. Independent human source comparisons support context-dependent plasma responses. An individual exercise study and the newer six-source crossover did not show a uniform age-related decrement; plasma profiles and dietary tracer appearance are not identical measurements.",
            "synthesis_limitations": "Mostly male dairy-tracer cohorts; between-study source/dose contrasts, nonrandomised age comparisons and different matrices limit generalisation. No brain transport, neurotransmitter or ADHD endpoint.",
            "evidence_considered": [{
              "label": "Gorissen et al. (2020)",
              "citation_key": "gorissen_phenylalanine_2020",
              "href": "/docs/papers/BRAIN-Diet-References#gorissen_phenylalanine_2020",
              "data_level": "Human Mechanistic",
              "exposure_context": "dietary whey, casein or milk protein",
              "evidence_source": "bounded-external-search",
              "directional_finding": "About half of dietary protein-derived phenylalanine appeared in the circulation over five hours. The fraction was lower for casein, higher with a larger dose, and slightly lower in older adults.",
              "assessment": {
                "study": "Pooled analysis of 18 randomised trials using intrinsically labelled whey, casein or milk protein.",
                "population": "602 participants, mean age 53 years. The age comparison used 82 young adults and 83 older adults.",
                "result": "Dietary phenylalanine entered the circulation. Protein type, dose and age changed the fraction that appeared.",
                "effect_magnitude": "Mean appearance 50% ± 14% over five hours. Casein 45% ± 11%, whey 57% ± 10%, milk 65% ± 13%. Older adults 45% ± 10% versus young adults 51% ± 14%.",
                "evidence_summary": "A protein meal delivers phenylalanine into the circulation, and the amount depends on the protein, the dose and age.",
                "limitations": "Phenylalanine appearance is not the full indispensable set, not tryptophan, and not a brain or clinical endpoint."
              },
              "canonical_reference": {
                "author_year": "Gorissen et al. (2020)",
                "number": 6,
                "anchor": "#pm-ref-6"
              }
            }, {
              "label": "Non-animal protein-source crossover (2024)",
              "citation_key": "stage2-ref-pm1-nonanimal2024",
              "href": "?review=0#stage2-ref-pm1-nonanimal2024",
              "data_level": "Human Mechanistic",
              "evidence_source": "bounded-external-search",
              "exposure_context": "30 g protein as milk, mycoprotein, pea, lupin, spirulina or chlorella; five-hour sampling; at least seven-day washout.",
              "directional_finding": "Source-specific plasma profiles; some non-animal sources produced higher essential-amino-acid responses than the tested milk beverage. Integrated responses did not show a uniform age decrement.",
              "assessment": {
                "study": "Independent Exeter programme; randomised double-blind six-period crossover, 12 young and 10 older adults, both sexes.",
                "population": "Independent Exeter programme; randomised double-blind six-period crossover, 12 young and 10 older adults, both sexes.",
                "result": "Source-specific plasma profiles; some non-animal sources produced higher essential-amino-acid responses than the tested milk beverage. Integrated responses did not show a uniform age decrement.",
                "effect_magnitude": "Source-specific endpoint and uncertainty: Small cohorts; composition and food matrix differ, so no isolated digestibility estimate or universal ranking follows.",
                "evidence_summary": "Source-specific plasma profiles; some non-animal sources produced higher essential-amino-acid responses than the tested milk beverage. Integrated responses did not show a uniform age decrement.",
                "limitations": "Small cohorts; composition and food matrix differ, so no isolated digestibility estimate or universal ranking follows. Independent of Maastricht pooled dairy corpus; age analyses and six visits within a person are not six independent replications."
              },
              "canonical_reference": {
                "author_year": "Non-animal protein-source crossover (2024)",
                "number": 10,
                "anchor": "#pm-ref-10"
              }
            }, {
              "label": "Pennings et al. (2011): exercise before protein",
              "citation_key": "stage2-ref-pm1-exercise2011",
              "href": "?review=0#stage2-ref-pm1-exercise2011",
              "data_level": "Human Mechanistic",
              "evidence_source": "bounded-external-search",
              "exposure_context": "Resistance-type exercise before labelled protein versus rest; six-hour tracer follow-up.",
              "directional_finding": "Dietary phenylalanine availability did not differ detectably with exercise although muscle incorporation increased.",
              "assessment": {
                "study": "Young/older men, rest/exercise comparisons; 48 participants total.",
                "population": "Young/older men, rest/exercise comparisons; 48 participants total.",
                "result": "Dietary phenylalanine availability did not differ detectably with exercise although muscle incorporation increased.",
                "effect_magnitude": "Source-specific endpoint and uncertainty: Muscle utilisation is not circulating-pool enhancement; a nonsignificant contrast is not equivalence.",
                "evidence_summary": "Dietary phenylalanine availability did not differ detectably with exercise although muscle incorporation increased.",
                "limitations": "Muscle utilisation is not circulating-pool enhancement; a nonsignificant contrast is not equivalence. NCT00557388 is part of Gorissen2020; no double-counting."
              },
              "canonical_reference": {
                "author_year": "Pennings et al. (2011): exercise before protein",
                "number": 15,
                "anchor": "#pm-ref-15"
              }
            }],
            "evidence_dependency": ["Shared sources with PM1-F1 and PM1-F2 are reused for distinct propositions, not independent replication. Pooled studies, thesis chapters and journal reports may overlap."],
            "sec_assessment_ref": {
              "id": "pm1-pm1-f1-assessment",
              "version": 2,
              "sha256": "336d59933b34411feab3c0e304315864917cdd5f34b28b2d31cc1a581af8cb4b"
            },
            "connected_supportive_evidence": []
          },
          pmId: "BRS1-FM1-PM1"
        }), "\n", "\n", _jsx("p", {
          children: _jsx("a", {
