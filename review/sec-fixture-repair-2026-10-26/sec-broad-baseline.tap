          title: 'Mitochondrial glutathione requires compartmental transport'
          proposition: 'SLC25A39 perturbation and organelle uptake experiments establish that mitochondrial glutathione depends on import. Precursor supply, cytosolic synthesis, mitochondrial transport and local glutathione use are separate steps.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          lastEvidenceAssessmentDate: '2026-10-24'
