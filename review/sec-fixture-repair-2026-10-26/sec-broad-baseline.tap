  actual:
    title: 'ROS Production and Control'
    pm_id: 'BRS4-FM2-PM4'
    mission: 'Regulate mitochondrial superoxide and hydrogen peroxide generation in response to metabolic conditions, preserving physiological redox signalling while limiting excessive oxidant production.'
    parent_fm: 'BRS4(FM2)'
    parent_brs: 'BRS4'
    summary: 'Mitochondria produce oxidants as part of their response to changing energy demands. Keeping this production appropriately regulated allows cells to signal and adapt while limiting excessive oxidant exposure. This matters for understanding the metabolic environment in which brain cells function. The evidence here establishes source regulation and adaptive signalling in experimental models, alongside changes in oxidant emission in human muscle; these are different levels of biological observation.'
    key_constraints:
      0: 'BRS4(KC2) - Mitochondrial Cofactor Sufficiency'
    cofactors:
      0: 'selenium'
      1: 'manganese'
      2: 'zinc'
      3: 'copper'
    intervention_dominance: 'Not established'
    intervention_breakdown: 'Food-State Dominant'
    timing_specific: 'Yes'
    dose_sensitivity: 'No general optimisation dose established. Experimental exposures are retained in source assessments, not translated into food prescriptions.'
    phenome_relationships:
      0:
        target_phenome: 'Recovery Capacity'
        relationship_type: 'modulates'
        confidence: 'low-medium'
        evidence_level: 'observational'
        evidence_confidence: 'low-medium'
        rationale: 'Elevated glutathione and oxidative-stress markers in paediatric ADHD case–control work link mitochondrial ROS handling to redox recovery context; GSH is required for mitochondrial lactate metabolism and ROS neutralisation — this PM governs ROS production/control balance, not GSH synthesis (BRS2/BRS3).'
        references:
          0:
            index: 1
            label: 'Verlaet et al. (2019)'
            citation_key: 'verlaet_oxidative_2019'
            href: '/docs/papers/BRAIN-Diet-References#verlaet_oxidative_2019'
            data_level: 'Human Mechanistic'
      1:
        target_phenome: 'Stress Reactivity'
        relationship_type: 'modulates'
        confidence: 'low-medium'
        evidence_level: 'observational'
        evidence_confidence: 'low-medium'
        rationale: 'Oxidative-stress elevation in ADHD cohorts intersects stress-relevant redox tone — impaired ROS control may modulate allostatic load under repeated challenge without claiming oxidative stress causes ADHD.'
        references:
          0:
            index: 1
            label: 'Verlaet et al. (2019)'
            citation_key: 'verlaet_oxidative_2019'
            href: '/docs/papers/BRAIN-Diet-References#verlaet_oxidative_2019'
            data_level: 'Human Mechanistic'
          1:
            index: 2
            label: 'Öğütlü et al. (2022)'
            citation_key: 'ogutlu_mitochondrial_2023'
            href: '/docs/papers/BRAIN-Diet-References#ogutlu_mitochondrial_2023'
            data_level: 'Human Study'
    references:
      0: '[Packer et al. (1997) — Vitamin E and the Metabolic Antioxidant Network](/docs/papers/BRAIN-Diet-References#packer_vitamin_1997)'
      1: '[Kyriazis et al. (2022) — Impact of Diet Upon Mitochondrial Physiology (Review)](/docs/papers/BRAIN-Diet-References#kyriazis_impact_2022)'
      2: '[Verlaet et al. (2019) — A Case–control Comparison](/docs/papers/BRAIN-Diet-References#verlaet_oxidative_2019)'
      3: '[Öğütlü et al. (2022) — Mitochondrial Dysfunction in Attention Deficit Hyperactivity Disorder](/docs/papers/BRAIN-Diet-References#ogutlu_mitochondrial_2023)'
      4: '[Brand et al. (2016) — Suppressors of Superoxide-H2O2 Production at Site IQ of Mitochondrial Complex I Protect against Stem Cell Hyperplasia and Ischemia-Reperfusion Injury.](/docs/papers/BRAIN-Diet-References#brs4_brand2016_20261023)'
      5: '[Chouchani et al. (2014) — Ischaemic accumulation of succinate controls reperfusion injury through mitochondrial ROS.](/docs/papers/BRAIN-Diet-References#brs4_chouchani2014_20261023)'
      6: '[Guzy et al. (2005) — Mitochondrial complex III is required for hypoxia-induced ROS production and cellular oxygen sensing.](/docs/papers/BRAIN-Diet-References#brs4_guzy2005_20261023)'
      7: '[Anderson et al. (2009) — Mitochondrial H2O2 emission and cellular redox state link excess fat intake to insulin resistance in both rodents and humans.](/docs/papers/BRAIN-Diet-References#brs4_anderson2009_20261023)'
      8: '[Gram et al. (2015) — Skeletal muscle mitochondrial H2 O2 emission increases with immobilization and decreases after aerobic training in young and older men.](/docs/papers/BRAIN-Diet-References#brs4_gram2015_20261023)'
