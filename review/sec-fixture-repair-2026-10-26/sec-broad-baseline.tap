    <ScientificFinding finding={{"id":"PM2-F8","finding_label":"Vigorous activity bouts and variability","finding_statement":"Four brief vigorous bodyweight bouts daily produced small secondary continuous glucose monitoring (CGM) variability improvements over 48 hours in inactive adults with well-controlled type 2 diabetes; the primary mean-glucose contrast was not significant.","finding_summary":"Four brief vigorous bodyweight bouts daily produced small secondary continuous glucose monitoring (CGM) variability improvements over 48 hours in inactive adults with well-controlled type 2 diabetes; the primary mean-glucose contrast was not significant.","synthesis":"Primary mean difference -0.2 mmol/L (95% CI -0.4 to 0; p=0.07). Secondary SD -0.1 mmol/L, CV -1 percentage point and MAGE -0.3 mmol/L; time in range was null. Small secondary effects without multiplicity adjustment; short washout permits carryover. Not evidence for gentle walking or lasting clinical benefit.","synthesis_limitations":"Small secondary effects without multiplicity adjustment; short washout permits carryover. Not evidence for gentle walking or lasting clinical benefit.","synthesised_evidence_confidence":"not-yet-scored","evidence_considered":[{"label":"Babir et al. (2026)","href":"#stage2-ref-babir","data_level":"Human Study","evidence_source":"bounded-external-search","directional_finding":"Primary mean difference -0.2 mmol/L (95% CI -0.4 to 0; p=0.07). Secondary SD -0.1 mmol/L, CV -1 percentage point and MAGE -0.3 mmol/L; time in range was null.","assessment":{"study":"Two 48-hour crossover periods: four one-minute vigorous bodyweight bouts daily versus usual activity; at least one hour between bouts, encouraged after meals.","population":"31 inactive adults with well-controlled, non-insulin-treated type 2 diabetes.","result":"Primary mean difference -0.2 mmol/L (95% CI -0.4 to 0; p=0.07). Secondary SD -0.1 mmol/L, CV -1 percentage point and MAGE -0.3 mmol/L; time in range was null.","limitations":"Small secondary effects without multiplicity adjustment; short washout permits carryover. Not evidence for gentle walking or lasting clinical benefit.","retrieval_scope":"Full primary Methods/Results","effect_magnitude":"Primary mean difference -0.2 mmol/L (95% CI -0.4 to 0; p=0.07). Secondary SD -0.1 mmol/L, CV -1 percentage point and MAGE -0.3 mmol/L; time in range was null.","evidence_summary":"Primary mean difference -0.2 mmol/L (95% CI -0.4 to 0; p=0.07). Secondary SD -0.1 mmol/L, CV -1 percentage point and MAGE -0.3 mmol/L; time in range was null. Small secondary effects without multiplicity adjustment; short washout permits carryover. Not evidence for gentle walking or lasting clinical benefit."},"citation_key":"stage2-ref-babir","canonical_reference":{"author_year":"Babir et al. (2026)","number":11,"anchor":"#pm-ref-11"}}],"sec_assessment_ref":{"id":"glycaemic-f8-assessment-v1","version":2,"sha256":"d6ff93c65397da5a2622e9f88bdb6c632f0b895674cc0162fd4a606cd391ae33"},"connected_supportive_evidence":[]}} pmId={"BRS6-FM1-PM2"} />
    
