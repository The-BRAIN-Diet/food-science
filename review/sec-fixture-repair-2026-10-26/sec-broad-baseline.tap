            1:
              date: '2026-10-18'
              decision: 'User authorised controlled canonical integration of this exact reviewed proposition. Assessment maturity and scores unchanged; this is not qualified human scientific review.'
          previousAssessments:
            0:
              pmId: 'BRS6-FM1-PM2'
              recordVersion: 1
              lastEvidenceAssessmentDate: '2026-10-18'
