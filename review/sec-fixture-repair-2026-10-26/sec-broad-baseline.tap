    dietary_input_traceability:
      - atom_id: PM3-DIT-1
        dietary_input: true
        dietary_input_note: "Dietary applicability is already admitted in the Direct/Derived section. This does not establish ordinary-food equivalence, a quantitative requirement, extra-intake benefit or independent supply of a derived product."
        input: Methionine
        input_type: substrate
        biological_role: Direct amino-acid substrate for MAT-dependent SAMe formation
        evidence_source:
          finding_ids:
            - PM3-F1
          citation_keys:
            - bailey_human_mat2a_2021
            - murray_crystallography_2016
        evidence_limitation: >-
          No ordinary-diet human dose-response demonstrating increased MAT-dependent
          SAMe synthesis was identified.
      - atom_id: PM3-DIT-2
        dietary_input: false
        dietary_input_note: "This accepted entry records an intracellular reaction participant or endogenous product, with no independently admitted dietary supply relationship in this PM. No does not assert absence from foods or biological dispensability."
        input: ATP
        input_type: substrate
        biological_role: Direct adenine-nucleotide substrate for MAT-dependent SAMe formation
        evidence_source:
          finding_ids:
            - PM3-F1
          citation_keys:
            - bailey_human_mat2a_2021
            - murray_crystallography_2016
        evidence_limitation: >-
          Diet does not supply ATP to MAT; no dietary ATP lever for SAMe synthesis
          is established.
      - atom_id: PM3-DIT-3
        dietary_input: false
        dietary_input_note: "This accepted entry records an intracellular reaction participant or endogenous product, with no independently admitted dietary supply relationship in this PM. No does not assert absence from foods or biological dispensability."
        input: Magnesium ions (Mg²⁺)
        input_type: catalytic ion
        biological_role: >-
          Active-site metal ion coordinating ATP-derived phosphate groups during MAT
          catalysis
        evidence_source:
          finding_ids:
            - PM3-F1
          citation_keys:
            - murray_crystallography_2016
        evidence_limitation: >-
          No ordinary-diet human evidence demonstrates magnesium-responsive MAT
          flux.
      - atom_id: PM3-DIT-4
        dietary_input: false
        dietary_input_note: "This accepted entry records an intracellular reaction participant or endogenous product, with no independently admitted dietary supply relationship in this PM. No does not assert absence from foods or biological dispensability."
        input: Potassium ions (K⁺)
        input_type: catalytic ion
        biological_role: >-
          Active-site metal ion positioning ATP-derived phosphoryl groups during MAT
          catalysis
        evidence_source:
          finding_ids:
            - PM3-F1
          citation_keys:
            - murray_crystallography_2016
        evidence_limitation: >-
          No ordinary-diet human evidence demonstrates potassium-responsive MAT
