      49:
        sha256: '0a633bf5226c46eee4b2e4499875affd1295c2d92909336548492122262a31cf'
        record:
          id: 'pm1-pm1-f1-assessment'
          recordVersion: 1
          pmId: 'BRS1-FM1-PM1'
          findingId: 'PM1-F1'
          title: 'Dietary protein delivers circulating phenylalanine; kinetics depend on context'
          proposition: 'Dietary protein supplies phenylalanine to the human circulation, with delivery kinetics varying by the tested protein source, dose and meal context. The pooled age association is context-dependent, not proof that ageing uniformly impairs absorption or that greater availability increases brain neurotransmitters.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          factors:
            D: 2
            B: 1
            P: 1
            R: 1
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rawScore: 5
          adjustedScore: 5
          capRationale: 'Directness 2, Bias Protection 1 and Precision 1: no D1/B0/P0 ceiling applies. Replication 0 receives no extra decrement.'
          lastEvidenceAssessmentDate: '2026-10-18'
          rationale:
            D: 'Direct human dietary tracer appearance tests the specified supply process; concentration-only studies corroborate context, not exact flux.'
            B: 'Controlled isotope methods support supply, but pooled source/dose comparisons are not a single randomised contrast and age is observational. These are appraised residual concerns, not missing evidence automatically scored zero.'
            P: 'Measured appearance is informative, but reported variability and heterogeneous matrices permit materially different magnitudes; no universal age or dosage effect is asserted.'
            R: 'Independent source-response evidence partially corroborates the scoped claim; exact tracer/age/dose comparisons retain research-team dependence. Constituent pooled trials are not counted again.'
          limitations:
            0: 'Mostly male dairy-tracer cohorts; between-study source/dose contrasts, nonrandomised age comparisons and different matrices limit generalisation. No brain transport, neurotransmitter or ADHD endpoint.'
            1: "Evidence-confidence conclusions must distinguish limitations of the underlying scientific evidence from limitations of the framework's evidence retrieval and assessment. Absence of verified evidence within an assessment must not be represented as evidence of absence."
          sources:
            supporting:
              0: 'gorissen_phenylalanine_2020'
              1: 'stage2-ref-pm1-nonanimal2024'
              2: 'stage2-ref-pm1-exercise2011'
            contextual:
            contradictoryAssessment: 'Supporting and null outcomes are endpoint-specific. No uniform age impairment is asserted; exercise and newer source studies qualify that inference.'
            targetedChecks:
              0:
                doi: '10.1093/jn/nxaa024'
                role: 'supporting; age heterogeneity qualified'
                access: 'Full published PDF examined: abstract, data selection, tracer methods, statistics, results and limitations.'
                assessment: 'Pooled 18 laboratory RCT datasets; 602 participants, 590 men; age is not randomised. Dietary tracer enters circulation; protein type and dose affect kinetics. Pooled older-younger difference is not universal age impairment. Five-hour dietary phenylalanine appearance: 50% ± 14% overall; casein 45% ± 11%, whey 57% ± 10%, milk 65% ± 13% (means ± SD). Pooled older/young comparison: 45% ± 10% versus 51% ± 14%; not randomised age assignment. Reported variability and subgroup tests; interstudy comparisons and participant differences limit causal interpretation. One research programme; constituent trials and this pooled analysis must not be counted twice.'
              1:
                doi: '10.1017/S0007114524000163'
                role: 'supporting; contradicts a universal animal-over-plant hierarchy'
                access: 'Scite full-text Methods and Results, including randomisation, washout, assays, power and multiplicity; published Cambridge PDF checked.'
                assessment: 'Independent Exeter programme; randomised double-blind six-period crossover, 12 young and 10 older adults, both sexes. Source-specific plasma profiles; some non-animal sources produced higher essential-amino-acid responses than the tested milk beverage. Integrated responses did not show a uniform age decrement.  Small cohorts; composition and food matrix differ, so no isolated digestibility estimate or universal ranking follows. Independent of Maastricht pooled dairy corpus; age analyses and six visits within a person are not six independent replications.'
              2:
                doi: '10.3945/ajcn.2010.29649'
                role: 'contextual null for circulating delivery'
                access: 'Published abstract and full institutional thesis chapter 2 examined.'
                assessment: 'Young/older men, rest/exercise comparisons; 48 participants total. Dietary phenylalanine availability did not differ detectably with exercise although muscle incorporation increased.  Muscle utilisation is not circulating-pool enhancement; a nonsignificant contrast is not equivalence. NCT00557388 is part of Gorissen2020; no double-counting.'
            retrievalLimited:
              0:
                doi: '10.1093/jn/nxaa024'
                url: 'https://www.frieslandcampinainstitute.com/uploads/sites/19/2023/03/2020-Gorissen-et-al-J-Nutr.pdf'
                limitation: 'Full published PDF examined: abstract, data selection, tracer methods, statistics, results and limitations. Effect: no unexamined methods, uncertainty or replication credited.'
              1:
                doi: '10.3945/ajcn.2010.29649'
                url: 'https://www.sciencedirect.com/science/article/pii/S0002916523020828'
                limitation: 'Published abstract and full institutional thesis chapter 2 examined. Effect: no unexamined methods, uncertainty or replication credited.'
          methodology:
            name: 'Synthesised Evidence Confidence: Directness + Bias Protection + Precision + Replication'
            version: 'SEC calibration rubric and four-state contract, local 2026-10-18 baseline'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
          process: 'Codex PM1 mission-wide bounded Stage 2A/2B reassessment, 2026-10-18; web/PubMed, primary repositories and Scite recovery; no qualified human review inferred.'
