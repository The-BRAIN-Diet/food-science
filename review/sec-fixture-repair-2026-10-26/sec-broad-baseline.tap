            R: 0
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rationale:
            D: 'Direct MAGE comparison in the tested population.'
            B: 'Randomised crossover and washout help; unmasked training, baseline imbalance and missing CGM remain.'
            P: 'Small trial with uncertainty about sustained benefit; mean and oxidative endpoints do not all agree.'
            R: 'Only one independent supporting dataset for this exact protocol was verified in the bounded assessment. Independent replication was not established in this assessment. Related protocols are contextual, not automatic replications.'
          rawScore: 4
          adjustedScore: 4
          capRationale: 'No existing confidence ceiling is triggered. Replication 0, where assessed, is not an extra subtraction. No confidence is transferred to a different protocol.'
          scopeNote: 'Preview-only proposed Finding. No inference to ADHD, cognition, human dietary benefit beyond the tested endpoint, or long-term clinical outcomes.'
          limitations:
            0: 'Small unmasked trial, baseline imbalance and missing sensor record; oxidative-stress markers did not improve. No blanket superiority to all continuous exercise.'
            1: 'No human scientific review recorded. Provisional SEC is distinct from intervention admission and PM evidence-review status.'
          sources:
            supporting:
              0: 'stage2-ref-karstoft'
            contradictory:
            contextual:
            contradictoryAssessment: 'MAGE decreased 1.7 +/- 0.4 mmol/L within interval training; interval/control comparison p=0.01. Within-period mean glucose was inconclusive (p=0.08).'
            targetedChecks:
              0:
                doi: '10.1007/s00125-016-4170-6'
                role: 'Supporting variability; contextual null oxidative marker'
                access: 'Full publisher PDF Methods, Table 1 and Results'
                assessment: '14 adults with type 2 diabetes; 13 usable CGM records. Randomised crossover: ten supervised 60-minute sessions over two weeks, alternating three-minute slower/faster walking; continuous and inactive comparator periods, multiweek washout. Small unmasked trial, baseline imbalance and missing sensor record; oxidative-stress markers did not improve. No blanket superiority to all continuous exercise.'
            retrievalLimited:
