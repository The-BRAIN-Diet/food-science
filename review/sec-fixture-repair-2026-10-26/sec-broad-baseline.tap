            children: "Mechanistic explanation: Dietary protein and amino-acid availability"
          })
        }), "\n", "\n", _jsx(ScientificFinding, {
          finding: {
            "id": "PM1-F2",
            "finding_label": "Diet-wide amino-acid adequacy does not require identical complete meals",
            "presentation": "mechanistic-basis",
            "fm_rollup": false,
            "finding_summary": "Retain nutritional adequacy, but separate whole-diet coverage from acute food-specific kinetics.",
            "finding_interpretation": "Scope is circulating provision and the exact measured endpoint, not brain entry, neurotransmitter efficacy or a clinical recommendation.",
            "finding_statement": "Varied adult diets can provide digestible indispensable amino acids without requiring every meal to supply the full set. This nutritional-adequacy proposition does not establish an optimal neurotransmitter dose or demonstrate that all plant and animal foods have identical postprandial responses.",
            "synthesised_evidence_confidence": "not-yet-scored",
            "synthesis": "Existing vegetarian-diet and DIAAS reviews support adequacy across a varied diet. New human source and faba-bean studies qualify single-food composition/digestibility; they do not contradict adequate mixed diets. The recent systematic requirement review concerns quantitative requirements, not neurotransmitter enhancement.",
            "synthesis_limitations": "Requirement reviews are not direct tests of neurotransmitter response or every possible plant diet. Energy sufficiency, variety, age and clinical context remain relevant.",
            "evidence_considered": [{
              "label": "Mariotti and Gardner (2019)",
              "citation_key": "mariotti_dietary_2019",
              "href": "/docs/papers/BRAIN-Diet-References#mariotti_dietary_2019",
              "data_level": "Mechanistic",
              "exposure_context": "vegetarian and vegan dietary patterns",
              "evidence_source": "repository-inherited",
              "directional_finding": "Adult vegetarian diets that include protein-rich plant foods can meet protein and amino-acid requirements. Amino-acid deficiency is described as overstated.",
              "assessment": {
                "study": "Review of protein and amino-acid intakes from vegetarian and vegan diets in Western adults.",
                "population": "Adults, including older adults, eating vegetarian or vegan diets. Children are discussed separately.",
                "result": "Protein-rich plant foods can achieve protein and amino-acid adequacy in adults.",
                "effect_magnitude": "No single intake-response estimate. The result is adequacy against requirements, not a change in brain transmitters.",
                "evidence_summary": "Dietary patterns can cover the indispensable amino acids this pool requires.",
                "limitations": "Requirement coverage is not a plasma time course and not a neurotransmitter outcome."
              },
              "canonical_reference": {
                "author_year": "Mariotti and Gardner (2019)",
                "number": 1,
                "anchor": "#pm-ref-1"
              }
            }, {
              "label": "Moughan and Lim (2024)",
              "citation_key": "moughan_diaas_2024",
              "href": "/docs/papers/BRAIN-Diet-References#moughan_diaas_2024",
              "data_level": "Mechanistic",
              "exposure_context": "protein-quality scoring",
              "evidence_source": "repository-inherited",
              "directional_finding": "Protein quality is scored by digestible indispensable amino acids rather than by protein grams alone.",
              "assessment": {
                "study": "Review of the digestible indispensable amino acid score a decade after its introduction.",
                "population": "Not a new human trial. The score is applied to foods and diets.",
                "result": "Quality depends on digestible indispensable amino acids.",
                "effect_magnitude": "No neurotransmitter effect size.",
                "evidence_summary": "Coverage of those amino acids is the quality claim this mechanism can use.",
                "limitations": "A scoring review does not measure circulating or brain amino acids."
              },
