          id: 'glycaemic-f7-assessment-v1'
          findingId: 'PM2-F7'
          title: 'Interval walking and glucose variability'
          pmId: 'BRS6-FM1-PM2'
          proposition: 'Two weeks of the tested supervised interval-walking programme reduced mean amplitude of glycaemic excursions (MAGE) versus an inactive control period in a small type 2 diabetes crossover trial.'
          recordVersion: 1
          lastEvidenceAssessmentDate: '2026-10-18'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          factors:
            D: 2
            B: 1
