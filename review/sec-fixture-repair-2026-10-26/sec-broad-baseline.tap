            exposure_context: 'Primary metabolomics, isotope tracing and pharmacological perturbation of ischaemia/reperfusion.'
            directional_finding: 'Accumulated succinate oxidation on reperfusion drove complex-I reverse-electron-transport ROS and injury.'
            assessment:
              study: 'Primary metabolomics, isotope tracing and pharmacological perturbation of ischaemia/reperfusion.'
              population: 'Cellular and animal ischaemia/reperfusion models.'
              result: 'Accumulated succinate oxidation on reperfusion drove complex-I reverse-electron-transport ROS and injury.'
              effect_magnitude: 'Study-specific direction retained; no pooled estimate or ordinary-food effective dose inferred.'
              evidence_summary: 'Accumulated succinate oxidation on reperfusion drove complex-I reverse-electron-transport ROS and injury.'
              limitations: 'Pathological reperfusion is not a meal experiment; the origin of ischaemic succinate has been debated in subsequent primary work. No dietary succinate advice follows.'
              retrieval_scope: 'Primary abstract retrieved from Europe PMC/PubMed; no unavailable full-method quantities inferred.'
              source_url: 'https://pubmed.ncbi.nlm.nih.gov/25383517/'
              publication_classification: 'primary-experimental'
