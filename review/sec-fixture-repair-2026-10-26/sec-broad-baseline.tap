        sha256: '792d1fa50803b2586ba5cefd3fe965b70abf50178c70f430b6000e0adf365fa7'
        record:
          id: 'brs4-pm5-pm5-f2-sec'
          recordVersion: 2
          pmId: 'BRS4-FM2-PM5'
          findingId: 'PM5-F2'
          title: 'Ubiquinol has a local antioxidant role distinct from electron transport'
          proposition: 'Reduced CoQ10 inhibited induced lipid peroxidation in beef-heart submitochondrial particles even after vitamin E removal, demonstrating a local protective chemistry separate from its electron-carrier role.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          lastEvidenceAssessmentDate: '2026-10-24'
          recordedOn: '2026-10-24'
          process: 'Codex bounded SEC follow-up v2: targeted primary Results/Methods recovery, exact-proposition precision and replication appraisal; no default factors, dietary inference or human review inferred.'
          methodology:
            name: 'Existing SEC four-factor anchors and integrated caps'
            version: '2026-10-24-pm4-pm5-followup-v2'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html#sec-assessment-status'
          factors:
            D: 2
            B: 1
            P: 1
            R: 1
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rationale:
            D: 'Forsmark primary indexed Results, Table I and Figures 1–3 descriptions directly compare extraction/reconstitution in beef-heart submitochondrial particles with no HPLC-detectable vitamin E; this is the exact local chemistry claim, not oral CoQ delivery.'
            B: 'Matched extraction/reconstitution, HPLC composition checks and convergent oxygen-consumption/MDA assays address material identity and nonspecific suppression. Residual protein-bound CoQ, extraction-induced changes, missing biological-batch/dispersion reporting and artificial oxidation remain important concerns (B1).'
            P: 'Recovered Results describe loss and return of oxidation inhibition with extraction/re-addition, near-complete MDA suppression in the relevant reduced-CoQ condition, and absent detectable vitamin E. These controlled qualitative contrasts discriminate a protective capacity from its absence. Effect-size dispersion, detection limits and reproducibility across biological preparations remain uncertain (P1, not P2); no confidence intervals are fabricated.'
            R: 'Independent Yamamoto/Komuro/Niki 1990 and Frei/Kim/Ames 1990 primary experiments corroborate ubiquinol-10 antiperoxidative activity in defined liposomes without requiring co-supplied tocopherol. They differ from Forsmark mitochondrial particles and do not independently reproduce its complete extraction protocol. R1 credits partial mechanism confirmation only.'
          rawScore: 5
          adjustedScore: 5
          capRationale: 'D2/B1/P1/R1 raw 5; no D1/B0/P0 cap applies; adjusted 5. No unapproved extra downgrade.'
          limitations:
            0: 'Reconstitution is not dietary delivery. Endogenous CoQ synthesis, oxidised/reduced forms, supplement formulation, tissue uptake and membrane antioxidant activity are distinct relationships. A mitochondrial-disease trial showed only limited effects and did not establish local antioxidant mediation.'
            1: 'Recover and appraise full figure-level quantitative reporting and independent historical particle experiments for the exact vitamin-E-independent proposition.'
          sources:
            supporting:
              0: 'brs4_forsmark1991_20261023'
            contextual:
              0: 'brs4_glover2010_20261023'
            targetedChecks:
              0:
                doi: '10.1016/0014-5793(91)80720-n'
                role: 'supporting exact scoped proposition'
                access: 'Primary abstract examined; PMID2065780. No full-method concentrations extracted.'
                assessment: 'Ubiquinol inhibited lipid peroxidation even without vitamin E. Isolated particle chemistry; no oral delivery, tissue dose or human outcome.'
              1:
                doi: '10.1002/mus.21758'
                role: 'contextual; not independent replication of the core mechanism'
                access: 'Primary abstract retrieved from Europe PMC/PubMed; no unavailable full-method quantities inferred.'
                assessment: 'Small effects on exercise aerobic capacity and post-exercise lactate; other clinically relevant variables did not improve. Not proof of mitochondrial membrane protection or ordinary-food efficacy; disease/formulation-specific exposure.'
              2:
                doi: '10.3177/jnsv.36.505'
                role: 'supporting partial replication; independent liposomal chemistry, not mitochondrial-particle protocol'
                access: 'Primary PubMed/J-STAGE abstract; Scite body is only a 683-character proof note and was NOT treated as full Methods/Results'
                assessment: 'Yamamoto et al. (1990): reduced ubiquinol inhibits oxidation in defined phosphatidylcholine liposomes; oxidised ubiquinone lacks this activity. Model difference retained.'
              3:
                doi: '10.1073/pnas.87.12.4879'
                role: 'supporting partial replication; independent defined-liposome chemistry'
                access: 'Scite linear primary body, first 8000 characters: Introduction/Methods; primary PubMed abstract for results'
                assessment: 'Frei et al. (1990): purified components, controlled radical initiation and HPLC measurements support direct lipid antiperoxidative chemistry; not an independent submitochondrial-particle protocol.'
              4:
                doi: '10.1016/0014-5793(91)80720-n'
                role: 'supporting; recovered original indexed Results and Table I'
                access: 'Publisher PDF indexed Results/Methods passages; original complete PDF not downloaded'
                assessment: 'Forsmark et al. (1991): extraction removes detectable CoQ and tocopherol; re-addition restores the relevant respiratory/antiperoxidative contrasts. Residual bound CoQ acknowledged in the primary Results.'
            retrievalLimited:
              0:
                url: 'https://doi.org/10.1016/0014-5793(91)80720-n'
                limitation: 'Complete original PDF, biological-batch counts and curve-level dispersion not recovered. P1 is based on controlled qualitative discrimination, not a precise efficacy magnitude; no P2 credit.'
            contradictoryAssessment: 'Kagan et al. (1990) proposed tocopherol recycling as mediation; Forsmark directly tested removal/re-addition. Independent model-membrane studies support a direct antiperoxidative component. This does not deny tocopherol synergy or prooxidant reactions under other conditions.'
          evidenceLocations:
            0: 'Forsmark 1991 abstract and primary PDF page 39 methods'
            1: 'Glover 2010 clinical trial abstract (context only)'
            2: 'Forsmark indexed original Results p40: Table I and Figures 1–3 descriptions'
            3: 'Yamamoto 1990 primary abstract and Frei 1990 primary Methods/abstract'
          history:
            0:
              date: '2026-10-24'
              decision: 'User authorised SEC completion for approved PM4/PM5 reassessment. New versioned assessment; propositions, admissions, original confidence storage and all prior SEC records preserved. This is not qualified human scientific review.'
            1:
              date: '2026-10-24'
              decision: 'User requested investigation of all four remaining unscored Findings. Version 1 preserved unchanged; this version records recovered evidence and remaining essential gaps.'
