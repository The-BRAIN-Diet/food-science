      59:
        sha256: 'f46ff4a372d90d493009218d1d3541ee0876735dd2938ac6db6786c42f7957fe'
        record:
          id: 'pm1-pm1-f6-assessment'
          recordVersion: 1
          pmId: 'BRS1-FM1-PM1'
          findingId: 'PM1-F6'
          title: 'Extrusion altered early amino-acid kinetics, not demonstrated total loss'
          proposition: 'In a randomised crossover of nine healthy young adults, the tested high-moisture-extruded mycoprotein/pea blend delayed selected early plasma amino-acid responses relative to the dry blend. Total five-hour grouped amino-acid availability was not significantly different; the study does not establish poorer overall nutrition for all meat alternatives.'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          factors:
            D: 2
            B: 1
            P: 1
            R: 0
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rawScore: 4
          adjustedScore: 4
          capRationale: 'Directness 2, Bias Protection 1 and Precision 1: no D1/B0/P0 ceiling applies. Replication 0 receives no extra decrement.'
          lastEvidenceAssessmentDate: '2026-10-18'
          rationale:
            D: 'The claim is explicitly about measured plasma kinetics in the exact human crossover, not absolute absorption or clinical efficacy.'
            B: 'Randomised counterbalanced double-blind visits and analytical measurement support inference; n=9 and numerous endpoints with residual matrix differences warrant caution, not an invented critical-bias judgement.'
            P: 'Direction of selected early responses is resolved, but null integrated areas lack equivalence bounds; scope excludes a demonstrated total loss.'
            R: "One matched-product experimental line was assessed. The same group's different protein-source trial and technical in-vitro repeats do not replicate this exact intervention; independent replication was not established in this assessment."
          limitations:
            0: 'Single small trial, no dietary tracer, numerous secondary endpoints and laboratory reconstituted products. Not proof of equal total absorption or a reason to avoid all processed plant foods.'
            1: "Evidence-confidence conclusions must distinguish limitations of the underlying scientific evidence from limitations of the framework's evidence retrieval and assessment. Absence of verified evidence within an assessment must not be represented as evidence of absence."
          sources:
            supporting:
              0: 'stage2-ref-pm1-extrusion2024'
            contextual:
            contradictoryAssessment: 'Supporting and null outcomes are endpoint-specific. No significant total five-hour grouped exposure difference; not evidence of equivalence.'
            targetedChecks:
              0:
                doi: '10.1016/j.tjnut.2024.05.018'
                role: 'supporting for kinetic change; null integrated outcomes'
                access: 'Scite full-text human methods, composition, power/statistics and results examined.'
                assessment: 'Randomised double-blind counterbalanced crossover; nine young adults, five men/four women; minimum five-day separation. Extrusion delayed early responses and reduced selected peaks, including phenylalanine and tyrosine. Total five-hour grouped amino-acid availability was not significantly different. Phenylalanine peak: dry blend 72 ± 3 versus extruded 58 ± 3 micromol/L, P=0.020; time to peak 32 ± 4 versus 83 ± 20 minutes, P=0.037 (means ± SEM). Total five-hour grouped amino-acid iAUC: no statistically significant difference; no equivalence bounds inferred. Small single dataset; no tracer, many endpoints, uncertainty on paired differences; laboratory reconstituted products not every commercial meat alternative. Distinct study but same Exeter programme as nonanimal2024; not an independent replication of its six-source comparison.'
            retrievalLimited:
          methodology:
            name: 'Synthesised Evidence Confidence: Directness + Bias Protection + Precision + Replication'
            version: 'SEC calibration rubric and four-state contract, local 2026-10-18 baseline'
            source: 'system/reviews/sec-calibration/SEC-calibration-rubric-proposal.html'
          process: 'Codex PM1 mission-wide bounded Stage 2A/2B reassessment, 2026-10-18; web/PubMed, primary repositories and Scite recovery; no qualified human review inferred.'
          history:
            0:
              date: '2026-10-18'
              decision: 'Original canonical Finding and evidence preserved in baseline.mdx; this is a new review-only assessment version, not canonical admission.'
          previousAssessments:
          stoppingRationale: 'Mission steps, all five SOP categories and lifestyle candidates screened. Material source, preparation, timing, exercise and newer-evidence questions received targeted retrieval. Remaining access gaps are explicit; no exhaustive-review claim.'
