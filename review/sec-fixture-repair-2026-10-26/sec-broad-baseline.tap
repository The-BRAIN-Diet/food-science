          findingId: 'PM2-F5'
          title: 'Whole-grain processing and daily variability'
          pmId: 'BRS6-FM1-PM2'
          proposition: 'In adults with type 2 diabetes, the tested less-processed whole-grain package reduced daily glucose standard deviation and mean amplitude of glycaemic excursions (MAGE) versus a nutrient-matched finely processed package over two weeks.'
          recordVersion: 1
          lastEvidenceAssessmentDate: '2026-10-18'
          assessmentStatus: 'codex-provisional'
          assessmentComplete: true
          factors:
            D: 2
            B: 2
            P: 1
            R: 0
          factorStates:
            D: 'established'
            B: 'established'
            P: 'established'
            R: 'established'
          rationale:
            D: 'Exact food-package comparison with daily CGM dispersion endpoints.'
            B: 'Concealed randomisation, blinded CGM and initial analyst, order-adjusted intention-to-treat analysis; food masking was impossible.'
            P: 'Intervals support modest changes; short-term package effects do not identify a single food or durable benefit.'
            R: 'Only one independent supporting dataset for this exact protocol was verified in the bounded assessment. Independent replication was not established in this assessment. Related protocols are contextual, not automatic replications.'
          rawScore: 5
          adjustedScore: 5
          capRationale: 'No existing confidence ceiling is triggered. Replication 0, where assessed, is not an extra subtraction. No confidence is transferred to a different protocol.'
          scopeNote: 'Preview-only proposed Finding. No inference to ADHD, cognition, human dietary benefit beyond the tested endpoint, or long-term clinical outcomes.'
          limitations:
            0: 'A food package, not an isolated grain or fibre effect; unmasked foods, short duration. Concealed randomisation, blinded CGM, initial masked analysis and intention-to-treat models support appraisal.'
            1: 'No human scientific review recorded. Provisional SEC is distinct from intervention admission and PM evidence-review status.'
          sources:
            supporting:
              0: 'stage2-ref-aberg'
            contradictory:
            contextual:
            contradictoryAssessment: 'Daily glucose SD difference -0.16 mmol/L (95% CI -0.25 to -0.06); mean amplitude of glycaemic excursions (MAGE) -0.36 (-0.65 to -0.08). Time in range and CONGA were null.'
            targetedChecks:
              0:
                doi: '10.2337/dc20-0263'
                role: 'Supporting'
                access: 'Full primary Methods/Results'
                assessment: '31 adults with type 2 diabetes; 28 completed. Two-week crossover: intact oats, brown rice and coarse/kibbled bread versus matched finely processed whole-grain products; at least two-week washout. A food package, not an isolated grain or fibre effect; unmasked foods, short duration. Concealed randomisation, blinded CGM, initial masked analysis and intention-to-treat models support appraisal.'
            retrievalLimited:
          process: 'Codex bounded Stage 2A/2B reassessment, 2026-10-18, version 1; primary methods/results appraisal and protocol-specific admission review'
