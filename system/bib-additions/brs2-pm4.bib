@article{finkelstein_homocysteine_1998,
  title = {The metabolism of homocysteine: pathways and regulation},
  author = {Finkelstein, J. D.},
  year = {1998},
  journal = {European Journal of Pediatrics},
  volume = {157},
  number = {S2},
  pages = {S40--S44},
  doi = {10.1007/pl00014300},
  pmid = {9587024},
  abstract = {Two pathways, the methionine cycle and transsulfuration, account for virtually all methionine metabolism in mammals. Every tissue possesses the methionine cycle. Therefore, each can synthesize AdoMet, employ it for transmethylation, hydrolyze AdoHcy, and remethylate homocysteine. Transsulfuration, which occurs only in liver, kidney, small intestine and pancreas, is the means for catabolizing homocysteine. Liver has a unique isoenzyme of MAT that allows the utilization of excess methionine for the continued synthesis of AdoMet. Metabolic regulation is based on the distribution of available homocysteine between remethylation and conversion to cystathionine. The tissue content of the enzymes and their inherent kinetic properties provide the basis for the regulatory mechanism. The effector properties of the metabolites AdoMet, AdoHcy and methylTHF are of particular relevance.}
}

@article{lamers_vitamin_b6_methionine_cycle_2011,
  title = {Moderate vitamin {B}-6 restriction does not alter postprandial methionine cycle rates of remethylation, transmethylation, and total transsulfuration but increases the fractional synthesis rate of cystathionine in healthy young men and women},
  author = {Lamers, Yvonne and Coats, Bonnie and Ralat, Maria and Quinlivan, Eoin P. and Stacpoole, Peter W. and Gregory, Jesse F.},
  year = {2011},
  journal = {The Journal of Nutrition},
  volume = {141},
  number = {5},
  pages = {835--842},
  doi = {10.3945/jn.110.134197},
  pmid = {21430249},
  abstract = {Healthy young adults (4 male, 5 female; 20-35 y) received primed constant infusions of labelled methionine and leucine before and after 28 days of dietary vitamin B-6 restriction. Plasma PLP fell from 49 ± 4 nmol/L to 19 ± 2 nmol/L. Mean remethylation, transsulfuration, and transmethylation rates did not change. Plasma cystathionine rose from 142 ± 8 to 236 ± 9 nmol/L, and the fractional cystathionine synthesis rate increased by a mean of 12 percent in 8 of 9 participants. Individual responses varied.}
}
